---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { id } = Astro.params;

const supabase = getSupabaseServerClient(Astro.cookies);

// 1. Fetch Route
const { data: route } = await supabase.from('routes').select('*').eq('id', id).single();
if (!route) {
  return Astro.redirect(translatePath('/routes'));
}

// 2. Fetch Points
const { data: routePoints } = await supabase.from('route_points').select('*').eq('route_id', id);

// 3. Fetch Connections
const { data: routeConnections } = await supabase.from('route_connections').select('*').eq('route_id', id);

// 4. Fetch Profiles for collaborators (using the admin client would be better if RLS applies, 
// but since the patch allows admins only, we might need a public policy for profiles, OR we can fetch them securely here)
// Wait, the public needs to see collaborators! If the RLS patch only allowed admins, we must fetch profiles using a secure method or they won't show.
// For now, let's fetch them. If it fails, they just don't appear. We can add a public RLS policy for `avatar_url` and `first_name` later if needed.
const { data: profiles } = await supabase.from('profiles').select('id, full_name, avatar_url');
const allProfiles = profiles || [];

// Enrich points with collaborators data for UI
const enrichedPoints = (routePoints || []).map(pt => {
  const collabsData = (pt.collaborators || []).map((collabId: string) => {
    return allProfiles.find(p => p.id === collabId) || { id: collabId, full_name: 'Un membre', avatar_url: null };
  });

  const externalCollabsData = (pt.external_collaborators || []).map((name: string) => {
    return { is_external: true, full_name: name };
  });

  return { ...pt, collabsData: [...collabsData, ...externalCollabsData] };
});
---

<Layout title={`${route.title} | Transmission Circulaire`}>
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    /* Option 2: Carte Aquarelle */
    .leaflet-layer {
      filter: contrast(1.1) brightness(1.05) saturate(0.8);
    }
  </style>
  
  <main class="min-h-screen bg-[var(--color-tc-cream)] pt-8 pb-16">
    
    <!-- Container pour la carte avec marges -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      <!-- Hero / Map Section avec coins arrondis et plus haute -->
      <section class="relative w-full bg-gray-100 rounded-3xl overflow-hidden shadow-xl border-4 border-white" style="height: 75vh; min-height: 600px;">
        <div id="public-map" class="absolute inset-0 z-0"></div>
        
        <!-- Back button -->
        <div class="absolute top-6 left-6 z-20 pointer-events-auto">
          <a href={translatePath('/routes')} class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/90 backdrop-blur-md rounded-full shadow-lg font-bold text-[var(--color-tc-blue)] hover:text-[var(--color-tc-red)] hover:bg-white transition-all">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour aux routes
          </a>
        </div>
      </section>
    </div>

    <!-- Content Section -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 pointer-events-auto">
      <div class="bg-white rounded-3xl shadow-lg p-8 md:p-12 border border-[var(--color-tc-blue)]/10">
        
        <h1 class="text-4xl md:text-5xl font-display font-bold text-[var(--color-tc-blue)] mb-6 text-center">
          {route.title}
        </h1>
        
        {route.description && (
          <div class="prose prose-lg prose-blue max-w-none text-[var(--color-tc-blue)]/80 mb-12">
            {route.description.split('\n').map((paragraph: string) => (
              <p class="mb-4 leading-relaxed">{paragraph}</p>
            ))}
          </div>
        )}

        <!-- Actions / Liaisons List -->
        {routeConnections && routeConnections.length > 0 && (
          <div class="mt-12">
            <h2 class="text-2xl font-bold text-[var(--color-tc-blue)] mb-8 flex items-center gap-3">
              <svg class="w-7 h-7 text-[var(--color-tc-mustard)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
              </svg>
              Actions menées
            </h2>
            
            <div class="space-y-6">
              {routeConnections.map((conn: any) => {
                const start = enrichedPoints.find(p => p.id === conn.start_point_id);
                const end = enrichedPoints.find(p => p.id === conn.end_point_id);
                return (
                  <div class="bg-[var(--color-tc-cream)]/50 rounded-2xl p-6 border border-[var(--color-tc-blue)]/5 hover:border-[var(--color-tc-blue)]/20 transition-colors">
                    <div class="flex items-center gap-4 text-sm font-bold text-[var(--color-tc-red)] mb-3">
                      <span class="bg-white px-3 py-1 rounded-full shadow-sm">{start?.location_name || '...'}</span>
                      <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                      <span class="bg-white px-3 py-1 rounded-full shadow-sm">{end?.location_name || '...'}</span>
                    </div>
                    {conn.title && <h3 class="text-xl font-bold text-[var(--color-tc-blue)] mb-2">{conn.title}</h3>}
                    {conn.description && <p class="text-[var(--color-tc-blue)]/70 leading-relaxed">{conn.description}</p>}
                  </div>
                );
              })}
            </div>
          </div>
        )}

      </div>
    </section>
  </main>

  <!-- Script Leaflet depuis CDN -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  
  <script is:inline define:vars={{ enrichedPoints, routeConnections }}>
    // On exécute directement car le script est en bas de page
    setTimeout(() => {
      // 1. Initialiser la carte
      const map = L.map('public-map', {
        zoomControl: false,
        attributionControl: false, // Cache le texte d'attribution (on le mettra dans les mentions légales)
        scrollWheelZoom: false // Désactivé pour ne pas bloquer le défilement de la page
      }).setView([20, 0], 2); 
      
      L.control.zoom({ position: 'topright' }).addTo(map);

      // 2. Fond de carte Aquarelle (Stamen Watercolor)
      L.tileLayer('https://watercolormaps.collection.cooperhewitt.org/tile/watercolor/{z}/{x}/{y}.jpg', {
        attribution: 'Map tiles by Stamen Design, CC BY 3.0 &mdash; Map data &copy; OpenStreetMap',
        maxZoom: 16
      }).addTo(map);

      const markers = {};
      const tcRed = '#9B2C2C';
      const tcMustard = '#D69E2E';

      // Fonction pour générer une courbe douce (Bézier quadratique)
      function getBezierCurve(latlng1, latlng2, offsetFactor = 0.2) {
        const p1 = map.project(latlng1, 10);
        const p2 = map.project(latlng2, 10);
        
        // Point de contrôle perpendiculaire
        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const ctrlP = L.point(
          (p1.x + p2.x) / 2 - dy * offsetFactor,
          (p1.y + p2.y) / 2 + dx * offsetFactor
        );

        const points = [];
        const numSteps = 20;
        for (let i = 0; i <= numSteps; i++) {
          const t = i / numSteps;
          const u = 1 - t;
          const x = u * u * p1.x + 2 * u * t * ctrlP.x + t * t * p2.x;
          const y = u * u * p1.y + 2 * u * t * ctrlP.y + t * t * p2.y;
          points.push(map.unproject(L.point(x, y), 10));
        }
        return points;
      }

      // 3. Dessiner les lignes
      (routeConnections || []).forEach(conn => {
        try {
          const startPt = enrichedPoints.find(p => p.id === conn.start_point_id);
          const endPt = enrichedPoints.find(p => p.id === conn.end_point_id);
          
          if (startPt && endPt) {
            const curvePoints = getBezierCurve(
              [startPt.latitude, startPt.longitude], 
              [endPt.latitude, endPt.longitude]
            );

            // Couleur personnalisée
            const lineColor = conn.color || '#556B2F';
            
            // Pour que la ligne s'arrête exactement à la flèche (et pas dans le point d'arrivée),
            // on raccourcit géographiquement le dernier point de la courbe.
            // On calcule l'angle au zoom 3 (zoom de base)
            const ptA = map.project(curvePoints[19], 3);
            const ptB = map.project(curvePoints[20], 3);
            const angle = Math.atan2(ptB.y - ptA.y, ptB.x - ptA.x);
            const angleDeg = angle * (180 / Math.PI);

            // On recule le point de 25 pixels (au zoom 3)
            const offsetPx = 25;
            const newPtB = L.point(
              ptB.x - Math.cos(angle) * offsetPx,
              ptB.y - Math.sin(angle) * offsetPx
            );
            const arrowLatLng = map.unproject(newPtB, 3);
            
            // On remplace la fin de la courbe par ce point raccourci
            curvePoints[20] = arrowLatLng;

            const pl = L.polyline(curvePoints, {
              color: lineColor,
              weight: 5,
              opacity: 0.9,
              lineJoin: 'round'
            }).addTo(map);

            if (conn.title || conn.description) {
              const htmlContent = `
                <div class="p-1 max-w-[200px]">
                  <strong class="block text-[#2A4365] text-sm">${conn.title || 'Action'}</strong>
                  ${conn.description ? `<p class="text-xs text-gray-600 mt-1">${conn.description}</p>` : ''}
                </div>
              `;
              pl.bindTooltip(htmlContent, { sticky: true, className: 'bg-white rounded-xl shadow-lg border-0' });
              pl.bindPopup(htmlContent);
            }

            // L'icone de flèche centrée sur le nouveau point de fin
            const arrowIcon = L.divIcon({
              html: `<svg viewBox="0 0 24 24" width="24" height="24" style="transform: rotate(${angleDeg}deg); transform-origin: center; filter: drop-shadow(0px 2px 2px rgba(0,0,0,0.3));">
                      <polygon points="4,4 20,12 4,20" fill="${lineColor}" />
                     </svg>`,
              className: '',
              iconSize: [24, 24],
              iconAnchor: [12, 12]
            });
            
            // Flèche interactive=false pour ne pas bloquer les clics, zIndex = 100 pour être au-dessus de la ligne
            L.marker(arrowLatLng, { icon: arrowIcon, interactive: false, zIndexOffset: 100 }).addTo(map);
          }
        } catch(e) {
          console.error("Erreur de rendu de la ligne: ", e);
        }
      });

      // 4. Placer les points
      (enrichedPoints || []).forEach(pt => {
        const markerHtml = `
          <div style="
            width: 24px; height: 24px; 
            background-color: ${tcRed}; 
            border: 3px solid white; 
            border-radius: 50%; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.2s;
          " class="hover:scale-125"></div>
        `;
        
        const customIcon = L.divIcon({
          html: markerHtml,
          className: '',
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          popupAnchor: [0, -12]
        });

        const marker = L.marker([pt.latitude, pt.longitude], { icon: customIcon }).addTo(map);
        markers[pt.id] = marker;

        let collabsHtml = '';
        if (pt.collabsData && pt.collabsData.length > 0) {
          collabsHtml = `<div class="mt-3 border-t pt-2"><p class="text-[10px] font-bold text-gray-400 uppercase mb-1">Sur place</p><div class="flex flex-wrap gap-1">`;
          pt.collabsData.forEach(c => {
            if (c.avatar_url) {
              collabsHtml += `<img src="${c.avatar_url}" title="${c.full_name}" class="h-6 w-6 rounded-full ring-2 ring-white object-cover" />`;
            } else {
              collabsHtml += `<div title="${c.full_name}" class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-gray-200 ring-2 ring-white text-[8px] font-bold">${c.full_name?.charAt(0) || '?'}</div>`;
            }
          });
          collabsHtml += `</div></div>`;
        }

        const popupHtml = `
          <div class="p-1 min-w-[150px]">
            <h3 class="font-bold text-[#2A4365] text-sm">${pt.location_name}</h3>
            ${collabsHtml}
          </div>
        `;
        marker.bindTooltip(popupHtml, { direction: 'top', offset: [0, -12], className: 'bg-white rounded-xl shadow-lg border-0' });
        marker.bindPopup(popupHtml, { offset: [0, -12] });
      });

      // Centrer la carte sur les points
      if (enrichedPoints && enrichedPoints.length > 0) {
        const group = new L.featureGroup(Object.values(markers));
        map.fitBounds(group.getBounds(), { padding: [50, 50], maxZoom: 6 });
      }
    }, 100);
  </script>
</Layout>
