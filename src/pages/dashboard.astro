---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user }, error: userError } = await supabase.auth.getUser();

if (!user || userError) {
 return Astro.redirect(translatePath('/login'));
}

// Récupération du rôle
const { data: roleData, error: roleError } = await supabase
 .from('user_roles')
 .select('role')
 .eq('id', user.id)
 .single();

// Récupération du profil
const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user.id)
  .single();

const userRole = roleData?.role || 'Membre';

// Récupération des événements auxquels l'utilisateur est inscrit
const { data: userRegistrations } = await supabase
  .from('event_registrations')
  .select('event_id')
  .eq('user_id', user.id);

let registeredEvents: any[] = [];
if (userRegistrations && userRegistrations.length > 0) {
  const eventIds = userRegistrations.map((r: any) => r.event_id);
  const { data: eventsData } = await supabase
    .from('events')
    .select('*')
    .in('id', eventIds)
    .gte('date', new Date().toISOString())
    .order('date', { ascending: false });
    
  if (eventsData) {
    registeredEvents = eventsData;
  }
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
 const formData = await Astro.request.formData();
 const action = formData.get('action');
 
 if (action === 'logout') {
   await supabase.auth.signOut();
   return Astro.redirect(translatePath('/'));
 }
 
 if (action === 'delete_account') {
   const password = formData.get('password')?.toString();
   if (!password) {
     errorMessage = "Veuillez entrer votre mot de passe pour confirmer la suppression.";
   } else {
     // Check password
     const { error: signInError } = await supabase.auth.signInWithPassword({
       email: user.email!,
       password: password,
     });

     if (signInError) {
       errorMessage = "Mot de passe incorrect. La suppression a été annulée.";
     } else {
       // RPC to delete user
       const { error: deleteError } = await supabase.rpc('delete_user');
       
       if (deleteError) {
         errorMessage = "Une erreur est survenue lors de la suppression : " + deleteError.message;
       } else {
         await supabase.auth.signOut();
         return Astro.redirect(translatePath('/?deleted=true'));
       }
     }
   }
 }
}
---

<Layout title={`${t('dashboard.title')} | Transmission Circulaire`}>

 <main class="min-h-screen bg-[var(--color-tc-cream)] py-12">
 <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
 <div class="bg-[var(--color-tc-cream)] rounded-2xl shadow-lg border-2 border-[var(--color-tc-blue)] overflow-hidden">
 
 <!-- Header du Dashboard -->
 <div class="p-6 sm:p-8 lg:p-10 border-b border-[var(--color-tc-blue)]/10 bg-[var(--color-tc-cream)]/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="flex items-center gap-4">
      <div class="relative w-16 h-16 rounded-full bg-[var(--color-tc-cream)] border-2 border-[var(--color-tc-mustard)] overflow-hidden flex-shrink-0 hidden sm:block">
        {profile?.avatar_url ? (
          <img src={profile.avatar_url} alt="Avatar" class="w-full h-full object-cover" />
        ) : (
          <svg class="w-full h-full text-[var(--color-tc-blue)]/20 p-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-display font-bold text-[var(--color-tc-blue)] ">
          {t('dashboard.title')}
        </h1>
        <p class="mt-2 text-[var(--color-tc-blue)]/80">
          {t('dashboard.welcome')} <span class="font-semibold text-[var(--color-tc-olive)]">{profile?.full_name || user.email}</span>
        </p>
      </div>
    </div>
 <div class="text-right">
 <span class="inline-flex items-center rounded-md bg-[var(--color-tc-blue)]/10 px-3 py-1 text-sm font-medium text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 uppercase tracking-wider">
 {t('dashboard.role')} {userRole}
 </span>
 </div>
 </div>

 <!-- Contenu du Dashboard -->
 <div class="p-6 sm:p-8 lg:p-10">
 <h2 class="text-lg font-semibold text-[var(--color-tc-blue)] mb-6">{t('dashboard.tools')}</h2>
 
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 
 <!-- Tuile Profil -->
 <div class="bg-[var(--color-tc-card)] p-6 rounded-2xl border border-[var(--color-tc-blue)]/10 shadow-md hover:shadow-lg transition-shadow flex flex-col justify-between">
 <div>
 <h3 class="text-md font-bold text-[var(--color-tc-blue)] flex items-center gap-2">
 <svg class="w-5 h-5 text-[var(--color-tc-olive)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
 </svg>
 {t('dashboard.profile')}
 </h3>
 <p class="mt-2 text-sm text-[var(--color-tc-blue)]/70">{t('dashboard.profile.desc')}</p>
 </div>
 <a href={translatePath('/profile/edit')} class="mt-4 text-sm font-medium text-[var(--color-tc-olive)] hover:underline block text-left">{t('dashboard.edit')}</a>
 </div>

  {/* Outils Admin conditionnels */}
  {(userRole === 'admin' || userRole === 'super_admin') && (
    <>
      <div class="bg-[var(--color-tc-card)] p-6 rounded-2xl border border-[var(--color-tc-mustard)]/30 shadow-md hover:shadow-lg transition-shadow flex flex-col justify-between">
        <div>
          <h3 class="text-md font-bold text-[var(--color-tc-blue)] flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-tc-mustard)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            {t('dashboard.books')}
          </h3>
          <p class="mt-2 text-sm text-[var(--color-tc-blue)]/70">{t('dashboard.books.desc')}</p>
        </div>
        <a href={translatePath('/dashboard/books')} class="mt-4 text-sm font-medium text-[var(--color-tc-mustard)] hover:underline block text-left">{t('dashboard.books.manage')}</a>
      </div>

      <div class="bg-[var(--color-tc-card)] p-6 rounded-2xl border border-[var(--color-tc-olive)]/30 shadow-md hover:shadow-lg transition-shadow flex flex-col justify-between">
        <div>
          <h3 class="text-md font-bold text-[var(--color-tc-blue)] flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-tc-olive)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            {t('dashboard.events')}
          </h3>
          <p class="mt-2 text-sm text-[var(--color-tc-blue)]/70">{t('dashboard.events.desc')}</p>
        </div>
        <a href={translatePath('/dashboard/events')} class="mt-4 text-sm font-medium text-[var(--color-tc-olive)] hover:underline block text-left">{t('dashboard.events.manage')}</a>
      </div>
    </>
  )}

 {userRole === 'super_admin' && (
 <div class="bg-[var(--color-tc-card)] p-6 rounded-2xl border border-[var(--color-tc-red)]/30 shadow-md hover:shadow-lg transition-shadow flex flex-col justify-between">
 <div>
 <h3 class="text-md font-bold text-[var(--color-tc-blue)] flex items-center gap-2">
 <svg class="w-5 h-5 text-[var(--color-tc-red)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
 </svg>
 {t('dashboard.roles')}
 </h3>
 <p class="mt-2 text-sm text-[var(--color-tc-blue)]/70">{t('dashboard.roles.desc')}</p>
 </div>
 <a href={translatePath('/dashboard/roles')} class="mt-4 text-sm font-medium text-[var(--color-tc-red)] hover:underline block text-left">{t('dashboard.roles.manage')}</a>
 </div>
 )}
 
 </div>
 
  <!-- Événements à venir -->
  <div class="mt-12 pt-8 border-t border-[var(--color-tc-blue)]/10">
    <h2 class="text-lg font-semibold text-[var(--color-tc-blue)] mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-[var(--color-tc-mustard)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      Mes événements à venir
    </h2>
    
    {registeredEvents.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {registeredEvents.map(evt => (
          <a href={translatePath(`/events/${evt.id}`)} class="bg-white rounded-2xl p-6 border border-[var(--color-tc-blue)]/5 shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-[var(--color-tc-blue)] group-hover:text-[var(--color-tc-olive)] transition-colors line-clamp-2">{evt.title}</h3>
              <p class="text-sm text-[var(--color-tc-blue)]/70 mt-3 flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {new Date(evt.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' })}
              </p>
              <p class="text-sm text-[var(--color-tc-blue)]/70 mt-2 flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                <span class="truncate">{evt.location}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="bg-white/50 border border-[var(--color-tc-blue)]/5 rounded-2xl p-6 text-center">
        <p class="text-[var(--color-tc-blue)]/60 text-sm">Vous n'êtes inscrit à aucun événement à venir.</p>
        <a href={translatePath('/events')} class="inline-block mt-3 text-[var(--color-tc-olive)] font-medium text-sm hover:underline">Voir les événements disponibles →</a>
      </div>
    )}
  </div>
 
 <!-- Actions de compte -->
 <div class="mt-12 pt-8 border-t border-[var(--color-tc-blue)]/10">
   {errorMessage && (
     <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-md">
       <p class="text-sm text-red-700">{errorMessage}</p>
     </div>
   )}
   
   <div class="flex flex-col md:flex-row gap-6 justify-between items-start md:items-center">
     <form method="POST">
       <input type="hidden" name="action" value="logout" />
       <button type="submit" class="text-sm font-medium text-[var(--color-tc-blue)]/70 hover:text-[var(--color-tc-blue)] transition-colors flex items-center gap-2">
         <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
         </svg>
         {t('dashboard.logout')}
       </button>
     </form>

     <!-- Suppression de compte -->
     <form method="POST" class="flex flex-col sm:flex-row gap-3 items-start sm:items-center bg-red-50 p-4 rounded-xl border border-red-100" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible.')">
       <input type="hidden" name="action" value="delete_account" />
       <div class="flex-1 w-full sm:w-auto">
         <label for="password" class="sr-only">Mot de passe pour confirmer</label>
         <input type="password" name="password" id="password" required placeholder="Mot de passe" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-red-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6">
       </div>
       <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-700 transition-colors flex items-center justify-center gap-2 whitespace-nowrap bg-white px-4 py-2 rounded-md shadow-sm border border-red-200 hover:bg-red-50 w-full sm:w-auto">
         <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
         </svg>
         Supprimer mon compte
       </button>
     </form>
   </div>
 </div>

 </div>
 </div>
 </div>
 </main>
 
</Layout>
