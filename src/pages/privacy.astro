---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t('privacy.title')} | Transmission Circulaire`}>
  
  <main class="min-h-screen bg-white dark:bg-slate-900 py-16">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-slate-600 dark:text-slate-300">
      <h1 class="text-4xl font-display font-bold text-[var(--color-tc-blue)] dark:text-white mb-8">{t('privacy.title')}</h1>
      
      <div class="space-y-6">
        <p>{t('privacy.intro')}</p>
        
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8 mb-4">{t('privacy.h1')}</h2>
        <p>{t('privacy.p1')}</p>
        
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8 mb-4">{t('privacy.h2')}</h2>
        <p>{t('privacy.p2')}</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>{t('privacy.l1')}</li>
          <li>{t('privacy.l2')}</li>
          <li>{t('privacy.l3')}</li>
        </ul>
        
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8 mb-4">{t('privacy.h3')}</h2>
        <p>{t('privacy.p3')}</p>
        
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-8 mb-4">{t('privacy.h4')}</h2>
        <p>{t('privacy.p4')}</p>
      </div>
    </div>
  </main>
  

</Layout>
