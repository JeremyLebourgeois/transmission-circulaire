---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

let error = '';
let success = false;

if (Astro.request.method === 'POST') {
 const formData = await Astro.request.formData();
 const email = formData.get('email')?.toString();

 if (!email) {
 error = lang === 'en' ? 'Please enter your email address.' : 'Veuillez saisir votre adresse email.';
 } else {
 const supabase = getSupabaseServerClient(Astro.cookies);
 const { error: resetError } = await supabase.auth.resetPasswordForEmail(email, {
 redirectTo: new URL(Astro.request.url).origin + translatePath('/reset-password'),
 });

 if (resetError) {
 error = resetError.message;
 } else {
 success = true;
 }
 }
}
---

<Layout title={lang === 'en' ? "Forgot password | Circular Transmission" : "Mot de passe oublié | Transmission Circulaire"}>

 <main class="min-h-screen flex items-center justify-center bg-[var(--color-tc-cream)] py-12 px-4 sm:px-6 lg:px-8">
 <div class="max-w-md w-full space-y-8 bg-[var(--color-tc-card)] p-6 sm:p-10 rounded-3xl mx-4 sm:mx-0 shadow-2xl border border-[var(--color-tc-blue)]/10">
 <div>
 <h2 class="mt-6 text-center text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)]">
 {lang === 'en' ? 'Forgot password' : 'Mot de passe oublié'}
 </h2>
 <p class="mt-2 text-center text-sm text-[var(--color-tc-blue)]/80">
 {lang === 'en' ? 'Enter your email to receive a reset link' : 'Entrez votre email pour recevoir un lien de réinitialisation'}
 </p>
 </div>
 
 {success ? (
 <div class="bg-green-50 border border-green-200 text-green-700 px-6 py-8 rounded-xl text-center space-y-4">
 <svg class="mx-auto h-12 w-12 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76" />
 </svg>
 <h3 class="text-lg font-medium">{lang === 'en' ? 'Email sent!' : 'Email envoyé !'}</h3>
 <p class="text-sm">
   {lang === 'en' 
     ? 'If this account exists, you will receive an email containing a link to reset your password.'
     : 'Si ce compte existe, vous allez recevoir un email contenant un lien pour changer votre mot de passe.'}
 </p>
 </div>
 ) : (
 <form class="mt-8 space-y-6" method="POST">
 {error && (
 <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm text-center">
 {error}
 </div>
 )}
 
 <div class="space-y-4 rounded-md shadow-sm">
 <div>
 <label for="email" class="sr-only">{lang === 'en' ? 'Email address' : 'Adresse email'}</label>
 <input id="email" name="email" type="email" required class="relative block w-full rounded-lg border-0 py-3 px-4 text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6" placeholder={lang === 'en' ? 'Email address' : 'Adresse email'}>
 </div>
 </div>

 <div>
 <button type="submit" class="flex w-full justify-center rounded-lg bg-[var(--color-tc-olive)] px-3 py-3 text-sm font-semibold leading-6 text-white shadow-md hover:bg-opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-transform transform hover:-translate-y-0.5">
 {lang === 'en' ? 'Send reset link' : 'Envoyer le lien'}
 </button>
 </div>
 </form>
 )}
 
 <p class="mt-10 text-center text-sm text-[var(--color-tc-blue)]/70">
 <a href={translatePath('/login')} class="font-semibold leading-6 text-[var(--color-tc-olive)] hover:text-opacity-80">
 {lang === 'en' ? '← Back to login' : '← Retour à la connexion'}
 </a>
 </p>
 </div>
 </main>

</Layout>
