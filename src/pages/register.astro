---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

let error = '';
let success = false;

// Si déjà connecté, on redirige vers le dashboard
const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();

if (session) {
 return Astro.redirect(translatePath('/dashboard'));
}

if (Astro.request.method === 'POST') {
 const formData = await Astro.request.formData();
 const email = formData.get('email')?.toString();
 const password = formData.get('password')?.toString();
 const consent = formData.get('consent');

 if (!email || !password || !consent) {
 error = 'Veuillez remplir tous les champs et accepter la politique de confidentialité.';
 } else {
 const { error: signUpError } = await supabase.auth.signUp({
 email,
 password,
 });

 if (signUpError) {
 error = signUpError.message;
 } else {
 success = true;
 }
 }
}
---

<Layout title={`${t('auth.register.title')} | Transmission Circulaire`}>

 
 <main class="min-h-screen flex items-center justify-center bg-[var(--color-tc-cream)] py-12 px-4 sm:px-6 lg:px-8">
 <div class="max-w-md w-full space-y-8 bg-[var(--color-tc-card)] p-10 rounded-3xl shadow-2xl border border-[var(--color-tc-blue)]/10 ">
 <div>
 <h2 class="mt-6 text-center text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] ">
 {t('auth.register.title')}
 </h2>
 <p class="mt-2 text-center text-sm text-[var(--color-tc-blue)]/80 ">
 {t('auth.register.subtitle')}
 </p>
 </div>
 
 {success ? (
 <div class="bg-green-50 border border-green-200 text-green-700 px-6 py-8 rounded-xl text-center space-y-4">
 <svg class="mx-auto h-12 w-12 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 <h3 class="text-lg font-medium">Inscription réussie !</h3>
 <p class="text-sm">Un email de confirmation vous a été envoyé. Veuillez cliquer sur le lien qu'il contient pour activer votre compte.</p>
 <a href={translatePath('/login')} class="inline-block mt-4 text-[var(--color-tc-olive)] font-bold hover:underline">Aller à la connexion</a>
 </div>
 ) : (
 <form class="mt-8 space-y-6" method="POST">
 {error && (
 <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm text-center">
 {error}
 </div>
 )}
 
 <div class="space-y-4 rounded-md shadow-sm">
 <div>
 <label for="email" class="sr-only">{t('auth.email')}</label>
 <input id="email" name="email" type="email" autocomplete="email" required class="relative block w-full rounded-t-lg border-0 py-3 px-4 text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6 " placeholder={t('auth.email')}>
 </div>
 <div>
 <label for="password" class="sr-only">{t('auth.password')}</label>
 <input id="password" name="password" type="password" required class="relative block w-full rounded-b-lg border-0 py-3 px-4 text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6 " placeholder={t('auth.password')}>
 </div>
 </div>

 <div class="flex items-start">
 <div class="flex h-6 items-center">
 <input id="consent" name="consent" type="checkbox" required class="h-4 w-4 rounded border-[var(--color-tc-blue)]/20 text-[var(--color-tc-olive)] focus:ring-[var(--color-tc-olive)]">
 </div>
 <div class="ml-3 text-sm leading-6">
 <label for="consent" class="text-[var(--color-tc-blue)]/70 ">
 {t('auth.consent.prefix')}<a href={translatePath('/privacy')} class="text-[var(--color-tc-blue)] hover:underline ">{t('auth.consent.link')}</a>{t('auth.consent.suffix')}
 </label>
 </div>
 </div>

 <div>
 <button type="submit" class="flex w-full justify-center rounded-lg bg-[var(--color-tc-olive)] px-3 py-3 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-transform transform hover:-translate-y-0.5">
 {t('auth.register.submit')}
 </button>
 </div>
 </form>
 )}
 
 {!success && (
 <p class="mt-10 text-center text-sm text-[var(--color-tc-blue)]/70">
 {t('auth.has_account')}
 <a href={translatePath('/login')} class="font-semibold leading-6 text-[var(--color-tc-blue)] hover:text-opacity-80 ml-1 ">
 {t('auth.login.link')}
 </a>
 </p>
 )}
 </div>
 </main>
 

</Layout>
