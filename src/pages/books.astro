---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const books = [
  {
    title: 'Meltem',
    author: 'Transmission Circulaire',
    coverImage: '/WhatsApp Image 2026-07-20 at 12.08.41.jpeg',
    description: 'Une plongée au cœur de la transmission intergénérationnelle. Cet ouvrage explore les liens qui nous unissent et les valeurs que nous partageons au-delà des âges.',
    link: '#'
  },
  {
    title: 'VALEUR',
    author: 'Luxe Universel et Au-delà',
    coverImage: '/WhatsApp Image 2026-07-20 at 12.10.58.jpeg',
    description: 'Une réflexion profonde sur la notion de valeur, le luxe universel et ce qui compte réellement dans notre société contemporaine.',
    link: 'https://lnkd.in/p/enAHxWFm'
  },
  {
    title: 'Transmission Circulaire',
    author: 'Editions Maïa',
    coverImage: '/WhatsApp Image 2026-07-20 at 12.10.59.jpeg',
    description: 'L\'ouvrage fondateur de notre association, détaillant notre mission, notre histoire et notre vision pour un avenir basé sur le partage de la paix et de la culture.',
    link: 'https://books.emeraldinsight.com/page/detail/Secrets-of-Working-Across-5-ContinentsSecrets-of-Working-Across-Five-Continents/?k=9781800430112'
  }
];
---

<Layout title={t('nav.books')}>
  <div class="bg-slate-50 dark:bg-slate-950 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-display font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">{t('nav.books')}</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Découvrez nos ouvrages dédiés à la transmission intergénérationnelle, la culture et la paix.
        </p>
      </div>
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        {books.map(book => (
          <BookCard {...book} />
        ))}
      </div>
    </div>
  </div>
</Layout>
