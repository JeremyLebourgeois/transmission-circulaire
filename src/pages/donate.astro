---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

let userRole = 'guest';
if (user) {
  const { data: roleData } = await supabase.from('user_roles').select('role').eq('id', user.id).single();
  userRole = roleData?.role || 'guest';
}
const isAdmin = userRole === 'super_admin' || userRole === 'admin';

let message = '';
let isError = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action')?.toString();

  if (action === 'delete_message' && isAdmin) {
    const messageId = formData.get('message_id')?.toString();
    if (messageId) {
      const { error } = await supabase.from('guestbook').delete().eq('id', messageId);
      if (error) {
        isError = true;
        message = "Erreur de suppression: " + error.message;
        console.error("GUESTBOOK DELETE ERROR:", error);
      } else {
        message = "Le message a été supprimé du livre d'or.";
      }
    }
  } else if (action === 'toggle_favorite' && isAdmin) {
    const messageId = formData.get('message_id')?.toString();
    const isFeatured = formData.get('is_featured') === 'true';
    if (messageId) {
      const { error } = await supabase.from('guestbook').update({ is_featured: !isFeatured }).eq('id', messageId);
      if (error) {
        isError = true;
        message = "Erreur lors de la mise en avant: " + error.message;
        console.error("GUESTBOOK FAVORITE ERROR:", error);
      }
    }
  } else if (user && (!action || action === 'add_message')) {
    const text = formData.get('message')?.toString();
    if (text && text.trim().length > 0) {
      const { error } = await supabase.from('guestbook').insert({
        user_id: user.id,
        message: text.trim()
      });
      if (error) {
        isError = true;
        message = "Une erreur est survenue: " + error.message;
        console.error("GUESTBOOK ERROR:", error);
      } else {
        message = "Merci pour votre message !";
      }
    } else {
      isError = true;
      message = "Le message ne peut pas être vide.";
    }
  }
}

// Fetch guestbook messages
const { data: guestbookData, error: fetchError } = await supabase
  .from('guestbook')
  .select('*, profiles(full_name)')
  .order('created_at', { ascending: false });
  
if (fetchError) {
  console.error("Erreur récupération guestbook:", fetchError);
}
  
const allMessages = guestbookData || [];
const featuredMessages = allMessages.filter(m => m.is_featured);
const otherMessages = allMessages.filter(m => !m.is_featured);
