         <svg class="w-5 h-5 group-hover:-translate-y-0.5 transition-transform" id="toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
         </svg>
         Lire la suite du livre <span class="opacity-60 ml-1">({otherMessages.length})</span>
       </button>
     </div>
   )}

   <div id="guestbook-messages" class="hidden">
     {otherMessages.length > 0 && (
       <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
         {otherMessages.map(msg => (
           <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-[var(--color-tc-blue)]/10 relative overflow-hidden group hover:shadow-md transition-all">
             <!-- Decorative Quote -->
             <div class="absolute -top-6 -right-2 text-[10rem] leading-none text-[var(--color-tc-blue)] opacity-5 font-serif select-none pointer-events-none">
               "
             </div>
             
             <!-- Header: Avatar + Name + Date -->
             <div class="flex items-center gap-4 mb-6 relative z-10">
               <!-- Avatar -->
               <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-tc-mustard)]/10 flex items-center justify-center text-[var(--color-tc-mustard)] font-display font-bold text-xl border border-[var(--color-tc-mustard)]/20 shadow-sm">
                 {(msg.profiles?.full_name || 'A').charAt(0).toUpperCase()}
               </div>
               <div>
                 <div class="font-bold text-[var(--color-tc-blue)] text-base">{msg.profiles?.full_name || 'Anonyme'}</div>
                 <div class="text-[var(--color-tc-blue)]/50 text-xs mt-0.5">{new Date(msg.created_at).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
               </div>
             </div>
             
             <!-- Message -->
             <div class="relative z-10">
               <p class="text-[var(--color-tc-blue)]/90 italic leading-relaxed text-lg font-serif whitespace-pre-wrap">« {msg.message} »</p>
             </div>

             <!-- Footer: Admin Delete -->
             {isAdmin && (
               <div class="absolute top-4 right-4 z-20 flex gap-2">
                 <form method="POST">
                   <input type="hidden" name="action" value="toggle_favorite" />
                   <input type="hidden" name="message_id" value={msg.id} />
                   <input type="hidden" name="is_featured" value="false" />
                   <button type="submit" class="text-gray-400 bg-gray-50 hover:bg-yellow-50 hover:text-yellow-500 p-2 rounded-xl transition-colors opacity-0 group-hover:opacity-100" title="Mettre en avant">
                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
                   </button>
                 </form>
                 <form method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer ce message définitivement ?');">
                   <input type="hidden" name="action" value="delete_message" />
                   <input type="hidden" name="message_id" value={msg.id} />
                   <button type="submit" class="text-red-400 hover:text-red-600 bg-red-50 hover:bg-red-100 p-2 rounded-xl transition-colors opacity-0 group-hover:opacity-100" title="Supprimer le message (Admin)">
                     <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                   </button>
                 </form>
               </div>
             )}
           </div>
         ))}
       </div>
     )}
   </div>
 </div>
 </div>
 </div>
</Layout>

<script>
  const toggleBtn = document.getElementById('toggle-guestbook-btn');
  const messagesContainer = document.getElementById('guestbook-messages');
  
  const messageInput = document.getElementById('message');
  if (messageInput) {
    messageInput.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = (this.scrollHeight) + 'px';
    });
  }

  if (toggleBtn && messagesContainer) {
    toggleBtn.addEventListener('click', () => {
      messagesContainer.classList.toggle('hidden');
      if (messagesContainer.classList.contains('hidden')) {
        toggleBtn.innerHTML = `
          <svg class="w-5 h-5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          Lire la suite du livre <span class="opacity-60 ml-1">(${messagesContainer.querySelectorAll('.group').length})</span>
        `;
      } else {
        toggleBtn.innerHTML = `
          <svg class="w-5 h-5 group-hover:-translate-y-0.5 transition-transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          Fermer
        `;
      }
    });
  }

  const copyBtn = document.getElementById('copy-email-btn');
  const copyMsg = document.getElementById('copy-success-msg');
  
  if (copyBtn && copyMsg) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('transmission.circulaire@gmail.com');
        copyMsg.style.opacity = '1';
        setTimeout(() => {
          copyMsg.style.opacity = '0';
        }, 2000);
      } catch (err) {
        console.error('Erreur lors de la copie', err);
      }
    });
  }
</script>
