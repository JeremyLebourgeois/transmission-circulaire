---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../../i18n/utils';
import { getSupabaseServerClient } from '../../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const { id } = Astro.params;

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

// Fetch role
let userRole = 'membre';
if (user) {
  const { data: roleData } = await supabase.from('user_roles').select('role').eq('id', user.id).single();
  if (roleData) userRole = roleData.role;
}

const isCollaborator = ['adherent', 'tresorier', 'admin', 'super_admin'].includes(userRole);
const isAdmin = userRole === 'admin' || userRole === 'super_admin';

let message = '';
let isError = false;

if (Astro.request.method === 'POST' && user) {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'register') {
    const { error } = await supabase.from('event_registrations').insert({ event_id: id, user_id: user.id });
    if (error) {
      isError = true;
      message = "Erreur lors de l'inscription : " + error.message;
      console.error(error);
    } else {
      message = "Inscription confirmée !";
    }
  } else if (action === 'unregister') {
    const { error } = await supabase.from('event_registrations').delete().match({ event_id: id, user_id: user.id });
    if (error) {
      isError = true;
      message = "Erreur lors de la désinscription.";
    } else {
      message = "Inscription annulée.";
    }
  } else if (action === 'force_unregister' && isAdmin) {
    const registrationId = formData.get('registration_id');
    const { error } = await supabase.from('event_registrations').delete().eq('id', registrationId);
    if (error) {
      isError = true;
      message = "Erreur lors de la désinscription : " + error.message;
    } else {
      message = "Membre désinscrit avec succès.";
    }
  }
}

let registeredUsers = [];
if (isAdmin) {
  const { data: regs } = await supabase
    .from('event_registrations')
    .select('id, user_id')
    .eq('event_id', id);
    
  if (regs && regs.length > 0) {
    const userIds = regs.map(r => r.user_id);
    const { data: profiles } = await supabase
      .from('profiles')
      .select('*')
      .in('id', userIds);
      
    registeredUsers = regs.map(reg => {
      const p = (profiles || []).find(p => p.id === reg.user_id);
      return {
        id: reg.id,
        user_id: reg.user_id,
        first_name: p ? (p.first_name || p.full_name || 'Inconnu') : 'Inconnu',
        last_name: p ? (p.last_name || '') : '',
        email: p ? (p.email || 'N/A') : 'N/A'
      };
    });
  }
}

const { data: evt } = await supabase
  .from('events')
  .select('*')
  .eq('id', id)
  .single();

if (!evt) {
  return Astro.redirect(translatePath('/events'));
}

const { count: registrationsCount } = await supabase
  .from('event_registrations')
  .select('*', { count: 'exact', head: true })
  .eq('event_id', id);

const { count: userRegCount } = user ? await supabase
  .from('event_registrations')
  .select('*', { count: 'exact', head: true })
  .match({ event_id: id, user_id: user.id }) : { count: 0 };

const isRegistered = (userRegCount || 0) > 0;
const spotsRemaining = evt.max_spots ? evt.max_spots - (registrationsCount || 0) : null;
const isFull = evt.max_spots !== null && spotsRemaining !== null && spotsRemaining <= 0;
const targetDate = (evt.end_date && evt.end_date.trim() !== '') ? evt.end_date : evt.date;
const isPast = new Date(targetDate).getTime() < Date.now();
const canRegister = user && (evt.audience !== 'collaborator_only' || isCollaborator) && !isPast;
---

<Layout title={`${evt.title} | Événements`}>
  <main class="min-h-screen bg-[var(--color-tc-cream)]">
    <!-- Hero Section -->
    <div class="bg-[var(--color-tc-blue)] text-white py-16 sm:py-24 px-4">
      <div class="max-w-5xl mx-auto flex flex-col gap-6 text-center sm:text-left">
        <a href={translatePath('/events')} class="text-white/60 hover:text-white text-sm inline-flex items-center justify-center sm:justify-start gap-1 mb-2 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Retour aux événements
        </a>
        <h1 class="text-4xl sm:text-5xl font-display font-bold leading-tight">{evt.title}</h1>
        <div class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-4 sm:gap-6 text-white/80 mt-4 bg-white/5 rounded-2xl p-4 border border-white/10 w-fit mx-auto sm:mx-0">
          <div class="flex items-start gap-2">
            <svg class="w-6 h-6 text-[var(--color-tc-mustard)] mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <time datetime={evt.date} class="font-medium text-lg flex flex-col gap-0.5 text-left">
              {evt.end_date ? (
                <>
                  <span>Du {new Date(evt.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'long', hour: '2-digit', minute:'2-digit' })}</span>
                  <span>Au {new Date(evt.end_date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'long', hour: '2-digit', minute:'2-digit' })}</span>
                </>
              ) : (
                <span>{new Date(evt.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute:'2-digit' })}</span>
              )}
            </time>
          </div>
          <div class="hidden sm:block w-px h-6 bg-white/20"></div>
          <div class="flex items-center gap-2">
            <svg class="w-6 h-6 text-[var(--color-tc-red)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="font-medium text-lg">{evt.location}</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-4 mt-6">
          {evt.max_spots && (
            <div class="bg-white/10 rounded-full px-4 py-2 border border-white/20 text-sm font-medium">
              🎟️ {spotsRemaining} places restantes sur {evt.max_spots}
            </div>
          )}
          {evt.audience === 'collaborator_only' && (
            <div class="bg-purple-500/20 text-purple-200 rounded-full px-4 py-2 border border-purple-500/30 text-sm font-medium flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Réservé aux adhérents
            </div>
          )}
        </div>

        {message && (
          <div class={`mt-6 p-4 rounded-xl text-sm font-medium border w-fit mx-auto sm:mx-0 ${isError ? 'bg-red-500/20 border-red-500/50 text-red-100' : 'bg-green-500/20 border-green-500/50 text-green-100'}`}>
            {message}
          </div>
        )}

        <div class="mt-8 flex justify-center sm:justify-start">
          {!user ? (
            <a href={translatePath('/login')} class="inline-flex items-center gap-2 bg-white text-[var(--color-tc-blue)] px-6 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors">
              Se connecter pour s'inscrire
            </a>
          ) : isRegistered ? (
            <form method="POST" class="inline-block">
              <input type="hidden" name="action" value="unregister" />
              <button type="submit" class="inline-flex items-center gap-2 bg-red-500/20 border border-red-500/50 text-red-100 px-6 py-3 rounded-full font-bold hover:bg-red-500/30 transition-colors">
                Annuler mon inscription
              </button>
            </form>
          ) : isPast ? (
            <div class="inline-flex items-center gap-2 bg-white/10 text-white/50 px-6 py-3 rounded-full font-bold cursor-not-allowed border border-white/10">
              Événement passé
            </div>
          ) : isFull ? (
            <div class="inline-flex items-center gap-2 bg-white/10 text-white/50 px-6 py-3 rounded-full font-bold cursor-not-allowed border border-white/10">
              Complet
            </div>
          ) : !canRegister ? (
            <div class="inline-flex items-center gap-2 bg-white/10 text-white/50 px-6 py-3 rounded-full font-bold cursor-not-allowed border border-white/10" title="Réservé aux adhérents">
              Réservé aux adhérents
            </div>
          ) : (
            <form method="POST" class="inline-block">
              <input type="hidden" name="action" value="register" />
              <button type="submit" class="inline-flex items-center gap-2 bg-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] px-8 py-3 rounded-full font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                S'inscrire à l'événement
              </button>
            </form>
          )}
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
      {isAdmin && (
        <section class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-red-500/20">
          <h2 class="text-2xl font-display font-bold text-red-600 mb-6 flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Administration : Liste des inscrits ({registeredUsers.length})
          </h2>
          
          {registeredUsers.length > 0 ? (
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="py-3 px-4 text-sm font-semibold text-gray-600">Nom</th>
                    <th class="py-3 px-4 text-sm font-semibold text-gray-600 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {registeredUsers.map((reg) => (
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                      <td class="py-3 px-4 text-sm text-gray-800 font-medium">
                        {reg.first_name} {reg.last_name}
                      </td>
                      <td class="py-3 px-4 text-sm text-right">
                        <form method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir désinscrire cette personne ?');">
                          <input type="hidden" name="action" value="force_unregister" />
                          <input type="hidden" name="registration_id" value={reg.id} />
                          <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-bold uppercase tracking-wider bg-red-50 hover:bg-red-100 px-3 py-1 rounded-full transition-colors">
                            Désinscrire
                          </button>
                        </form>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-gray-500 italic">Aucun inscrit pour le moment.</p>
          )}
        </section>
      )}

      {evt.image_url && (
        <div class="rounded-3xl overflow-hidden shadow-2xl border border-[var(--color-tc-blue)]/10 bg-[var(--color-tc-cream)]">
          <img src={evt.image_url} alt={evt.title} class="w-full object-cover max-h-[600px]" />
        </div>
      )}
      
      {evt.description && (
        <section class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-[var(--color-tc-blue)]/5">
          <h2 class="text-2xl font-display font-bold text-[var(--color-tc-blue)] mb-6 flex items-center gap-3">
            <svg class="w-6 h-6 text-[var(--color-tc-olive)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
            </svg>
            À propos de cet événement
          </h2>
          <div class="prose prose-lg max-w-none text-[var(--color-tc-blue)]/80 leading-relaxed whitespace-pre-wrap">{evt.description}</div>
        </section>
      )}
    </div>
  </main>
</Layout>
