---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).filter((lang) => lang !== 'fr').map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.events')}>
  <div class="bg-white dark:bg-slate-950 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-display font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">{t('nav.events')}</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Rejoignez-nous lors de nos prochains ateliers, rencontres et événements pour échanger et partager.
        </p>
      </div>
      
      <div class="mx-auto mt-16 max-w-2xl border-t border-slate-200 dark:border-slate-800 pt-10 sm:mt-20 sm:pt-16 lg:mx-0 lg:max-w-none">
        <!-- Event Card Placeholder -->
        <article class="flex max-w-xl flex-col items-start justify-between bg-slate-50 dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-x-4 text-xs">
            <time datetime="2026-10-15" class="text-slate-500 dark:text-slate-400">15 Octobre 2026</time>
            <a href="#" class="relative z-10 rounded-full bg-white dark:bg-slate-800 px-3 py-1.5 font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">Rencontre</a>
          </div>
          <div class="group relative">
            <h3 class="mt-3 text-lg font-bold font-display leading-6 text-slate-900 dark:text-white group-hover:text-[var(--color-tc-mustard)] transition-colors">
              <a href="#">
                <span class="absolute inset-0"></span>
                Soirée de Lancement : "Meltem"
              </a>
            </h3>
            <p class="mt-5 line-clamp-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
              Venez célébrer avec nous la sortie de notre nouvel ouvrage "Meltem". Au programme : dédicaces, échanges autour de la transmission intergénérationnelle et cocktail dînatoire.
            </p>
          </div>
          <div class="relative mt-8 flex items-center gap-x-4">
            <div class="h-10 w-10 rounded-full bg-[var(--color-tc-blue)] flex items-center justify-center text-white font-bold">
              TC
            </div>
            <div class="text-sm leading-6">
              <p class="font-semibold text-slate-900 dark:text-white">
                <a href="#">
                  <span class="absolute inset-0"></span>
                  L'équipe Transmission Circulaire
                </a>
              </p>
              <p class="text-slate-600 dark:text-slate-400">Paris, France</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>
