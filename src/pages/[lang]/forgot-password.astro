---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

let error = '';
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString();

  if (!email) {
    error = 'Veuillez saisir votre adresse email.';
  } else {
    const supabase = getSupabaseServerClient(Astro.cookies);
    const { error: resetError } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: 'http://localhost:4321' + translatePath('/reset-password'),
    });

    if (resetError) {
      error = resetError.message;
    } else {
      success = true;
    }
  }
}
---

<Layout title="Mot de passe oublié | Transmission Circulaire">

  
  <main class="min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white dark:bg-slate-800 p-10 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-700">
      <div>
        <h2 class="mt-6 text-center text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] dark:text-white">
          Mot de passe oublié
        </h2>
        <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-400">
          Entrez votre email pour recevoir un lien de réinitialisation
        </p>
      </div>
      
      {success ? (
        <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 px-6 py-8 rounded-xl text-center space-y-4">
          <svg class="mx-auto h-12 w-12 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76" />
          </svg>
          <h3 class="text-lg font-medium">Email envoyé !</h3>
          <p class="text-sm">Si ce compte existe, vous allez recevoir un email contenant un lien pour changer votre mot de passe.</p>
        </div>
      ) : (
        <form class="mt-8 space-y-6" method="POST">
          {error && (
            <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 px-4 py-3 rounded-lg text-sm text-center">
              {error}
            </div>
          )}
          
          <div class="space-y-4 rounded-md shadow-sm">
            <div>
              <label for="email" class="sr-only">Adresse email</label>
              <input id="email" name="email" type="email" required class="relative block w-full rounded-lg border-0 py-3 px-4 text-slate-900 dark:text-white ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6 dark:bg-slate-900" placeholder="Adresse email">
            </div>
          </div>

          <div>
            <button type="submit" class="flex w-full justify-center rounded-lg bg-[var(--color-tc-blue)] px-3 py-3 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-transform transform hover:-translate-y-0.5">
              Envoyer le lien
            </button>
          </div>
        </form>
      )}
      
      <p class="mt-10 text-center text-sm text-slate-500">
        <a href={translatePath('/login')} class="font-semibold leading-6 text-[var(--color-tc-olive)] hover:text-opacity-80">
          ← Retour à la connexion
        </a>
      </p>
    </div>
  </main>
  

</Layout>
