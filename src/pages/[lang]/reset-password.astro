---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

let error = '';
let success = false;

const supabase = getSupabaseServerClient(Astro.cookies);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString();
  const confirmPassword = formData.get('confirmPassword')?.toString();

  if (!password || !confirmPassword) {
    error = lang === 'en' ? 'Please fill in all fields.' : 'Veuillez remplir tous les champs.';
  } else if (password !== confirmPassword) {
    error = lang === 'en' ? 'Passwords do not match.' : 'Les mots de passe ne correspondent pas.';
  } else if (password.length < 6) {
    error = lang === 'en' ? 'Password must be at least 6 characters long.' : 'Le mot de passe doit faire au moins 6 caractères.';
  } else {
    const { error: updateError } = await supabase.auth.updateUser({
      password: password
    });

    if (updateError) {
      error = updateError.message;
    } else {
      success = true;
    }
  }
}
---

<Layout title={lang === 'en' ? 'New password | Circular Transmission' : 'Nouveau mot de passe | Transmission Circulaire'}>

 <main class="min-h-screen flex items-center justify-center bg-[var(--color-tc-cream)] py-12 px-4 sm:px-6 lg:px-8">
 <div class="max-w-md w-full space-y-8 bg-[var(--color-tc-card)] p-6 sm:p-10 rounded-3xl mx-4 sm:mx-0 shadow-2xl border border-[var(--color-tc-blue)]/10">
 <div>
 <h2 class="mt-6 text-center text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)]">
 {lang === 'en' ? 'New password' : 'Nouveau mot de passe'}
 </h2>
 <p class="mt-2 text-center text-sm text-[var(--color-tc-blue)]/80">
 {lang === 'en' ? 'Choose a new secure password' : 'Choisissez un nouveau mot de passe sécurisé'}
 </p>
 </div>
 
 {success ? (
 <div class="bg-green-50 border border-green-200 text-green-700 px-6 py-8 rounded-xl text-center space-y-4">
 <svg class="mx-auto h-12 w-12 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <h3 class="text-lg font-medium">{lang === 'en' ? 'Password updated!' : 'Mot de passe mis à jour !'}</h3>
 <p class="text-sm">{lang === 'en' ? 'Your password has been changed successfully.' : 'Votre mot de passe a été changé avec succès.'}</p>
 <a href={translatePath('/dashboard')} class="inline-block mt-4 text-[var(--color-tc-olive)] font-bold hover:underline">
   {lang === 'en' ? 'Go to dashboard' : 'Aller au tableau de bord'}
 </a>
 </div>
 ) : (
 <form class="mt-8 space-y-6" method="POST">
 {error && (
 <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm text-center">
 {error}
 </div>
 )}
 
 <div class="space-y-4 rounded-md shadow-sm">
 <div>
 <label for="password" class="sr-only">{lang === 'en' ? 'New password' : 'Nouveau mot de passe'}</label>
 <input id="password" name="password" type="password" required class="relative block w-full rounded-t-lg border-0 py-3 px-4 text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6" placeholder={lang === 'en' ? 'New password' : 'Nouveau mot de passe'}>
 </div>
 <div>
 <label for="confirmPassword" class="sr-only">{lang === 'en' ? 'Confirm password' : 'Confirmez le mot de passe'}</label>
 <input id="confirmPassword" name="confirmPassword" type="password" required class="relative block w-full rounded-b-lg border-0 py-3 px-4 text-[var(--color-tc-blue)] ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6" placeholder={lang === 'en' ? 'Confirm password' : 'Confirmez le mot de passe'}>
 </div>
 </div>

 <div>
 <button type="submit" class="flex w-full justify-center rounded-lg bg-[var(--color-tc-olive)] px-3 py-3 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-transform transform hover:-translate-y-0.5">
 {lang === 'en' ? 'Save' : 'Enregistrer'}
 </button>
 </div>
 </form>
 )}
 </div>
 </main>

</Layout>
