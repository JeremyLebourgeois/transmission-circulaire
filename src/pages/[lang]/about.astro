---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).filter((lang) => lang !== 'fr').map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.about')}>
  <!-- We can just import a shared component, but for now we reuse the HTML -->
  <div class="bg-white dark:bg-slate-950 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-display font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">{t('nav.about')}</h2>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Transmission Circulaire est une structure ancrée dans la transmission intergénérationnelle, de la paix et du partage des valeurs et de la culture.
        </p>
      </div>
      
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
        <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-slate-900 dark:text-white">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-[var(--color-tc-blue)] text-white font-bold">1</div>
              Notre Mission
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-slate-600 dark:text-slate-300">
              <p class="flex-auto">Favoriser le dialogue entre les générations et promouvoir la culture comme vecteur de paix et d'enrichissement mutuel.</p>
            </dd>
          </div>
          
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-slate-900 dark:text-white">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-[var(--color-tc-olive)] text-white font-bold">2</div>
              Notre Public
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-slate-600 dark:text-slate-300">
              <p class="flex-auto">Nous nous adressons aux jeunes, à nos adhérents, bénévoles, donateurs et au grand public soucieux des enjeux de transmission.</p>
            </dd>
          </div>
          
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-slate-900 dark:text-white">
              <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-[var(--color-tc-red)] text-white font-bold">3</div>
              Notre Histoire
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-slate-600 dark:text-slate-300">
              <p class="flex-auto">Fondée le 10 juin 2026, l'association s'est rapidement développée autour de projets éditoriaux et d'événements fédérateurs.</p>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</Layout>
