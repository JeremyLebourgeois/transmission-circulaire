---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
 return Object.keys(languages).filter((lang) => lang !== 'fr').map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.donate')}>
 <div class="bg-[var(--color-tc-cream)] py-24 sm:py-32">
 <div class="mx-auto max-w-7xl px-6 lg:px-8">
 <div class="mx-auto max-w-2xl text-center">
 <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">Soutenir l'Association</h2>
 <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/80 ">
 Votre soutien est essentiel pour nous permettre de continuer nos actions de transmission intergénérationnelle.
 </p>
 </div>
 
  <div class="mx-auto mt-16 max-w-5xl bg-[var(--color-tc-cream)] rounded-3xl shadow-xl overflow-hidden border border-[var(--color-tc-blue)]/10 ">
        <div class="p-6 sm:p-10 mx-4 sm:mx-0">
          <div class="flex flex-col items-center text-center mb-10">
            <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-[var(--color-tc-mustard)]/20 mb-6">
              <svg class="h-8 w-8 text-[var(--color-tc-mustard)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            </div>
            <h3 class="text-3xl font-display font-bold text-[var(--color-tc-blue)] mb-4">Devenir Adhérent</h3>
            <p class="text-[var(--color-tc-blue)]/80 max-w-2xl mx-auto text-lg">
              Rejoignez l'association et participez activement à nos évènements. L'adhésion vous donne accès à des avantages exclusifs tout au long de l'année.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
            <!-- Avantages -->
            <div class="bg-[var(--color-tc-card)] rounded-2xl p-6 sm:p-8 border border-[var(--color-tc-blue)]/5 shadow-sm">
              <h4 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6 flex items-center gap-3">
                <svg class="w-6 h-6 text-[var(--color-tc-olive)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
                Vos avantages
              </h4>
              <ul class="space-y-4">
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Networking international :</strong> Accès à un réseau de contacts et d'échanges.</span></li>
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Visites d'artisans :</strong> Découvertes autour de la thématique des cinq sens.</span></li>
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Ateliers pratiques :</strong> Apprendre à réaliser des choses par soi-même (DIY).</span></li>
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Accès aux expositions :</strong> Entrées et invitations.</span></li>
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Accès aux conférences :</strong> Assister aux événements.</span></li>
                <li class="flex items-start gap-3 text-[var(--color-tc-blue)]/80"><svg class="w-5 h-5 text-[var(--color-tc-mustard)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <span><strong>Mécénat :</strong> Soutenir et valoriser les jeunes talents.</span></li>
              </ul>
            </div>
            
            <!-- Tarifs -->
            <div class="flex flex-col gap-6">
              <!-- Tarif 1 -->
              <div class="bg-[var(--color-tc-blue)] rounded-2xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden group">
                <div class="absolute -right-6 -top-6 opacity-5 group-hover:scale-110 transition-transform duration-500">
                  <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"/></svg>
                </div>
                <h4 class="text-xl font-bold text-white mb-1 relative z-10">Jeunes Talents</h4>
                <p class="text-white/70 text-sm mb-6 relative z-10">Moins de 26 ans</p>
                <div class="flex items-end gap-2 mb-3 relative z-10">
                  <span class="text-5xl font-display font-bold">25€</span>
                  <span class="text-white/80 pb-1 font-medium">/ an</span>
                </div>
                <p class="text-sm text-[var(--color-tc-mustard)] relative z-10">Soit moins de 2.10€ par mois.</p>
              </div>

              <!-- Tarif 2 -->
              <div class="bg-[var(--color-tc-cream)] border-2 border-[var(--color-tc-blue)] rounded-2xl p-6 sm:p-8 shadow-sm relative overflow-hidden group">
                <h4 class="text-xl font-bold text-[var(--color-tc-blue)] mb-1">Talents</h4>
                <p class="text-[var(--color-tc-blue)]/60 text-sm mb-6">26 ans et plus</p>
                <div class="flex items-end gap-2 mb-3">
                  <span class="text-5xl font-display font-bold text-[var(--color-tc-blue)]">120€</span>
                  <span class="text-[var(--color-tc-blue)]/80 pb-1 font-medium">/ an</span>
                </div>
                <p class="text-sm text-[var(--color-tc-blue)]/70">Soit 10€ par mois.</p>
              </div>
            </div>
          </div>

          <div class="text-center mt-4">
            <a href="#" target="_blank" class="inline-flex justify-center items-center px-8 py-4 bg-[var(--color-tc-olive)] text-[var(--color-tc-cream)] rounded-full font-bold text-lg hover:bg-opacity-90 hover:scale-105 transition-all shadow-xl hover:shadow-2xl gap-3">
              Devenir Adhérent sur HelloAsso
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <p class="mt-4 text-sm text-[var(--color-tc-blue)]/60 flex justify-center items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
              Paiement 100% sécurisé via HelloAsso
            </p>
          </div>
        </div>
      </div>

      <!-- Section Don Libre & Bénévolat -->
      <div class="mx-auto mt-8 max-w-5xl bg-white rounded-3xl shadow-md overflow-hidden border border-[var(--color-tc-blue)]/5 p-6 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-8">
        <div class="flex-1 text-center sm:text-left">
          <h3 class="text-2xl font-display font-bold text-[var(--color-tc-blue)] mb-2 flex items-center justify-center sm:justify-start gap-3">
            <svg class="w-6 h-6 text-[var(--color-tc-olive)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            Soutenir librement
          </h3>
          <p class="text-[var(--color-tc-blue)]/70 max-w-xl text-sm sm:text-base">
            Vous souhaitez soutenir nos actions ponctuellement, sans forcément adhérer, ou nous proposer de l'aide bénévole ?
          </p>
        </div>
        <div class="flex flex-col gap-3 w-full sm:w-auto">
          <a href="https://www.helloasso.com/associations/transmission-circulaire/formulaires/1" target="_blank" class="inline-flex justify-center items-center px-6 py-3 bg-white text-[var(--color-tc-blue)] border border-[var(--color-tc-blue)]/20 rounded-full font-bold text-sm sm:text-base hover:bg-[var(--color-tc-cream)] transition-all shadow-sm">
            Faire un don libre via HelloAsso
          </a>
          <a href="mailto:transmission.circulaire@gmail.com?subject=Proposition%20de%20bénévolat" target="_blank" class="inline-flex justify-center items-center px-6 py-3 bg-[var(--color-tc-blue)]/5 text-[var(--color-tc-blue)] rounded-full font-medium text-sm sm:text-base hover:bg-[var(--color-tc-blue)]/10 transition-colors">
            Nous proposer du bénévolat
          </a>
        </div>
      </div>
 
 <!-- Mockup Supabase Guestbook / Soutien -->
 <div class="mx-auto mt-24 max-w-4xl text-center">
 <h3 class="text-2xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-3xl mb-4">Livre d'Or & Soutien</h3>
 <p class="text-[var(--color-tc-blue)]/80 mb-12 max-w-2xl mx-auto">
 Laissez-nous un message de soutien ! (Ce module sera bientôt connecté à notre base de données).
 </p>
 
 <div class="bg-[var(--color-tc-cream)] rounded-3xl shadow-lg border border-[var(--color-tc-blue)]/10 p-6 sm:p-8 text-left">
 <form class="space-y-6 opacity-50 pointer-events-none">
 <div>
 <label for="name" class="block text-sm font-medium leading-6 text-[var(--color-tc-blue)] ">Votre nom</label>
 <div class="mt-2">
 <input type="text" name="name" id="name" class="block w-full rounded-md border-0 py-1.5 text-[var(--color-tc-blue)] shadow-sm ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6 " placeholder="Jean Dupont">
 </div>
 </div>
 <div>
 <label for="message" class="block text-sm font-medium leading-6 text-[var(--color-tc-blue)] ">Votre message</label>
 <div class="mt-2">
 <textarea id="message" name="message" rows="4" class="block w-full rounded-md border-0 py-1.5 text-[var(--color-tc-blue)] shadow-sm ring-1 ring-inset ring-[var(--color-tc-blue)]/20 placeholder:text-[var(--color-tc-blue)]/60 focus:ring-2 focus:ring-inset focus:ring-[var(--color-tc-blue)] sm:text-sm sm:leading-6 " placeholder="Un grand merci pour vos actions..."></textarea>
 </div>
 </div>
 <button type="button" class="w-full flex justify-center rounded-md bg-[var(--color-tc-mustard)] px-3 py-3 text-sm font-semibold text-white shadow-md hover:bg-opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-tc-blue)]">
 Envoyer mon message (Bientôt disponible)
 </button>
 </form>
 </div>
 </div>
 </div>
 </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyMsg = document.getElementById('copy-success-msg');
  
  if (copyBtn && copyMsg) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('transmission.circulaire@gmail.com');
        copyMsg.style.opacity = '1';
        setTimeout(() => {
          copyMsg.style.opacity = '0';
        }, 2000);
      } catch (err) {
        console.error('Erreur lors de la copie', err);
      }
    });
  }
</script>
