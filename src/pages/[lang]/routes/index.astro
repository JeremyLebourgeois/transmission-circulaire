---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { getSupabaseServerClient } from '../../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const supabase = getSupabaseServerClient(Astro.cookies);

// Récupérer toutes les routes
const { data: routes } = await supabase
  .from('routes')
  .select('*')
  .order('created_at', { ascending: false });

// Check if current user is admin or guide
const { data: { user } } = await supabase.auth.getUser();
let userRole = '';
if (user) {
  const { data: roleData } = await supabase.from('user_roles').select('role').eq('id', user.id).single();
  userRole = roleData?.role || '';
  if (!userRole) {
    const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).single();
    userRole = profile?.role || '';
  }
}

---

<Layout title="Les Routes Circulaires | Transmission Circulaire">
  <main class="min-h-screen bg-[var(--color-tc-cream)] py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- En-tête -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-[var(--color-tc-blue)] mb-6">
          Nos Routes Circulaires
        </h1>
        <p class="text-lg text-[var(--color-tc-blue)]/80 leading-relaxed mb-6">
          Découvrez nos actions à travers le monde. Chaque route relie nos collaborateurs et met en lumière les projets culturels et solidaires que nous menons au quotidien.
        </p>

        {(userRole === 'admin' || userRole === 'super_admin' || userRole === 'guide') && (
          <a href={translatePath('/dashboard/routes')} class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-tc-red)] px-5 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-opacity-90 transition-all transform hover:-translate-y-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
            </svg>
            {t('routes.manage')}
          </a>
        )}
      </div>

      <!-- Grille des routes -->
      {routes && routes.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {routes.map((route) => (
            <a href={translatePath(`/routes/${route.id}`)} class="group flex flex-col bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[var(--color-tc-blue)]/10 transform hover:-translate-y-1">
              
              <div class="relative h-64 overflow-hidden bg-gray-100">
                {route.image_url ? (
                  <img 
                    src={route.image_url} 
                    alt={route.title} 
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" 
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                )}
                
                {/* Overlay au survol */}
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-tc-blue)]/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                  <span class="inline-flex items-center gap-2 text-white font-bold">
                    Explorer la carte
                    <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </div>

              <div class="p-8 flex flex-col flex-1">
                <h2 class="text-2xl font-bold text-[var(--color-tc-blue)] mb-3 group-hover:text-[var(--color-tc-red)] transition-colors">
                  {(lang === 'en' && route.title_en) ? route.title_en : route.title}
                </h2>
                <p class="text-[var(--color-tc-blue)]/70 line-clamp-3 mb-6 flex-1">
                  {(lang === 'en' && route.description_en) ? route.description_en : (route.description || "Découvrez cette route sur notre carte interactive.")}
                </p>
                
                <div class="pt-4 border-t border-[var(--color-tc-blue)]/10 text-sm font-medium text-[var(--color-tc-olive)] flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                  </svg>
                  Voir la carte
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-3xl p-12 text-center shadow-sm border border-[var(--color-tc-blue)]/10">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-xl font-bold text-[var(--color-tc-blue)]">Nos routes sont en cours de création</p>
          <p class="text-[var(--color-tc-blue)]/70 mt-2">Revenez bientôt pour découvrir nos premières actions à travers le monde.</p>
        </div>
      )}

    </div>
  </main>
</Layout>
