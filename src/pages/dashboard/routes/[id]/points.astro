---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath } from '../../../../i18n/utils';
import { getSupabaseServerClient } from '../../../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { id: routeId } = Astro.params;

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user }, error: userError } = await supabase.auth.getUser();

if (!user || userError) {
  return Astro.redirect(translatePath('/login'));
}

const { data: roleData } = await supabase.from('user_roles').select('role').eq('id', user.id).single();
const userRole = roleData?.role || 'Membre';

if (userRole !== 'admin' && userRole !== 'super_admin') {
  return Astro.redirect(translatePath('/dashboard'));
}

let errorMessage = '';
let successMessage = '';

// Handling actions (Server-side)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  try {
    if (action === 'add_point') {
      const locationName = formData.get('location_name')?.toString();
      const collabs = formData.getAll('collaborators[]');
      
      const extFirstNames = formData.getAll('ext_first_name[]');
      const extLastNames = formData.getAll('ext_last_name[]');
      let extCollabs = [];
      for (let i = 0; i < extFirstNames.length; i++) {
        const first = extFirstNames[i]?.toString().trim() || '';
        const last = extLastNames[i]?.toString().trim() || '';
        if (first || last) {
          extCollabs.push(`${first} ${last}`.trim());
        }
      }

      if (!locationName) throw new Error("Le nom du lieu est requis.");

      // 1. Geocoding via Nominatim (OpenStreetMap API)
      // On ajoute un User-Agent personnalisé car Nominatim bloque les requêtes anonymes
      // On force la langue en français pour éviter les noms en japonais/arabe etc.
      const geocodeRes = await fetch(
        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(locationName)}&format=json&limit=1&accept-language=fr`,
        {
          headers: {
            'User-Agent': 'TransmissionCirculaireApp/1.0 (transmission.circulaire@gmail.com)'
          }
        }
      );
      
      const responseText = await geocodeRes.text();
      let geocodeData;
      try {
        geocodeData = JSON.parse(responseText);
      } catch (err) {
        throw new Error("Erreur de géolocalisation avec OpenStreetMap : " + responseText);
      }
      
      let lat = null;
      let lon = null;
      
      if (geocodeData && geocodeData.length > 0) {
        lat = parseFloat(geocodeData[0].lat);
        lon = parseFloat(geocodeData[0].lon);
      } else {
        throw new Error(`Impossible de trouver les coordonnées pour : ${locationName}. Essayez d'être plus précis (ex: "Paris, France").`);
      }

      // 2. Insert into database
      const { error } = await supabase.from('route_points').insert({
        route_id: routeId,
        location_name: geocodeData[0].display_name.split(',')[0], // On garde le nom simplifié court
        latitude: lat,
        longitude: lon,
        collaborators: collabs,
        external_collaborators: extCollabs,
        bg_color: formData.get('bg_color')?.toString() || '#FAF9F6',
        border_color: formData.get('border_color')?.toString() || '#9B2C2C'
      });

      if (error) throw error;
      successMessage = "Point ajouté avec succès sur la carte !";
    } 
    else if (action === 'edit_point') {
      const pointId = formData.get('point_id')?.toString();
      const collabs = formData.getAll('collaborators[]');
      
      const extFirstNames = formData.getAll('ext_first_name[]');
      const extLastNames = formData.getAll('ext_last_name[]');
      let extCollabs = [];
      for (let i = 0; i < extFirstNames.length; i++) {
        const first = extFirstNames[i]?.toString().trim() || '';
        const last = extLastNames[i]?.toString().trim() || '';
        if (first || last) {
          extCollabs.push(`${first} ${last}`.trim());
        }
      }

      if (!pointId) throw new Error("ID du point manquant.");

      const { error } = await supabase.from('route_points').update({
        collaborators: collabs,
        external_collaborators: extCollabs,
        bg_color: formData.get('bg_color')?.toString() || '#FAF9F6',
        border_color: formData.get('border_color')?.toString() || '#9B2C2C'
      }).eq('id', pointId);

      if (error) throw error;
      successMessage = "Collaborateurs mis à jour !";
    }
    else if (action === 'delete_point') {
      const pointId = formData.get('point_id')?.toString();
      const { error } = await supabase.from('route_points').delete().eq('id', pointId);
      if (error) throw error;
      successMessage = "Point supprimé.";
    }
    else if (action === 'add_connection') {
      const startPoint = formData.get('start_point_id')?.toString();
      const endPoint = formData.get('end_point_id')?.toString();
      const title = formData.get('title')?.toString();
      const desc = formData.get('description')?.toString();
      const color = formData.get('color')?.toString() || '#556B2F';

      if (startPoint === endPoint) throw new Error("Le point de départ et d'arrivée doivent être différents.");

      const { error } = await supabase.from('route_connections').insert({
        route_id: routeId,
        start_point_id: startPoint,
        end_point_id: endPoint,
        title: title || '',
        description: desc || '',
        color: color
      });

      if (error) throw error;
      successMessage = "Liaison créée avec succès !";
    }
    else if (action === 'edit_connection') {
      const connId = formData.get('connection_id')?.toString();
      const title = formData.get('title')?.toString();
      const desc = formData.get('description')?.toString();
      const color = formData.get('color')?.toString() || '#556B2F';

      if (!connId) throw new Error("ID de liaison manquant.");

      const { error } = await supabase.from('route_connections').update({
        title: title || '',
        description: desc || '',
        color: color
      }).eq('id', connId);

      if (error) throw error;
      successMessage = "Liaison mise à jour !";
    }
    else if (action === 'delete_connection') {
      const connId = formData.get('connection_id')?.toString();
      const { error } = await supabase.from('route_connections').delete().eq('id', connId);
      if (error) throw error;
      successMessage = "Liaison supprimée.";
    }
  } catch (e: any) {
    errorMessage = e.message;
  }
}

// Fetch Route Details
const { data: route } = await supabase.from('routes').select('*').eq('id', routeId).single();
if (!route) {
  return Astro.redirect('/dashboard/routes');
}

// Fetch Points
const { data: points } = await supabase.from('route_points').select('*').eq('route_id', routeId);
const routePoints = points || [];

// Fetch Connections
const { data: conns } = await supabase.from('route_connections').select('*').eq('route_id', routeId);
const routeConnections = conns || [];

// Fetch Profiles (for collaborators selection)
let { data: profiles, error: profError } = await supabase.from('profiles').select('id, full_name, avatar_url, description').order('full_name');
if (profError) {
  const fallback = await supabase.from('profiles').select('id, full_name, avatar_url').order('full_name');
  profiles = fallback.data;
}
const allProfiles = profiles || [];

// Enrich points with collaborators data for UI
const enrichedPoints = routePoints.map(pt => {
  const collabsData = (pt.collaborators || []).map((collabId: string) => {
    return allProfiles.find(p => p.id === collabId) || { id: collabId, full_name: 'Inconnu' };
  });

  const externalCollabsData = (pt.external_collaborators || []).map((name: string) => {
    return { is_external: true, full_name: name };
  });

  return { ...pt, collabsData: [...collabsData, ...externalCollabsData] };
});
---

<Layout title={`Carte : ${route.title} | Transmission Circulaire`}>
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    /* Option 2: Carte Aquarelle */
    .leaflet-layer {
      filter: contrast(1.1) brightness(1.05) saturate(0.8);
    }
  </style>
  
  <main class="min-h-screen bg-[var(--color-tc-cream)] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8 flex items-center gap-4">
        <a href="/dashboard/routes" class="text-[var(--color-tc-blue)] hover:text-[var(--color-tc-red)] transition-colors inline-flex items-center gap-2 font-medium">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Retour aux routes
        </a>
      </div>

      <div class="mb-8 bg-white p-6 rounded-3xl shadow-sm border border-[var(--color-tc-blue)]/10 flex flex-col md:flex-row items-center gap-6">
        {route.image_url ? (
          <img src={route.image_url} alt={route.title} class="w-24 h-24 rounded-2xl object-cover shadow-sm border border-gray-100" />
        ) : (
          <div class="w-24 h-24 rounded-2xl bg-gray-100 flex items-center justify-center">
             <svg class="w-8 h-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
        )}
        <div>
          <h1 class="text-3xl font-display font-bold text-[var(--color-tc-blue)] mb-2">Carte : {route.title}</h1>
          <p class="text-[var(--color-tc-blue)]/70">{route.description || "Aucune description"}</p>
        </div>
      </div>

      {errorMessage && (
        <div class="mb-8 p-4 bg-red-100 border border-red-300 text-red-800 rounded-xl font-medium">
          {errorMessage}
        </div>
      )}

      {successMessage && (
        <div class="mb-8 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl font-medium">
          {successMessage}
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Colonne de gauche : Formulaires -->
        <div class="lg:col-span-1 space-y-6">
          
          <!-- Ajouter un point -->
          <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-lg border border-[var(--color-tc-blue)]/10 p-6">
            <h2 class="text-lg font-bold text-[var(--color-tc-blue)] mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-[var(--color-tc-red)]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              Ajouter une étape
            </h2>
            <form method="POST" class="space-y-4">
              <input type="hidden" name="action" value="add_point" />
              
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Ville, Pays *</label>
                <input type="text" name="location_name" required placeholder="Ex: Dakar, Sénégal" class="w-full rounded-xl border-0 py-2.5 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-sm" />
                <p class="text-[10px] text-gray-500 mt-1 mt-1">Le placement GPS sera automatique.</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Membres avec un compte</label>
                <div class="max-h-40 overflow-y-auto bg-white rounded-xl border border-gray-200 p-2 space-y-1">
                  {allProfiles.map(p => (
                    <label class="flex items-center gap-2 p-1 hover:bg-gray-50 rounded cursor-pointer">
                      <input type="checkbox" name="collaborators[]" value={p.id} class="rounded text-[var(--color-tc-olive)] focus:ring-[var(--color-tc-olive)]" />
                      {p.avatar_url ? (
                         <img src={p.avatar_url} class="w-5 h-5 rounded-full object-cover" />
                      ) : (
                         <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center text-[8px] font-bold">{p.full_name?.charAt(0) || '?'}</div>
                      )}
                      <span class="text-sm font-medium text-gray-700">{p.full_name}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="mb-4">
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Autres personnes (sans compte)</label>
                <div id="ext-collabs-add">
                  <div class="flex gap-2 mb-2">
                    <input type="text" name="ext_first_name[]" placeholder="Prénom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-sm" />
                    <input type="text" name="ext_last_name[]" placeholder="Nom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-sm" />
                  </div>
                </div>
                <button type="button" onclick="addExtCollabRow('ext-collabs-add')" class="text-xs text-[var(--color-tc-olive)] hover:underline font-bold">+ Ajouter une autre personne</button>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Couleur de fond</label>
                  <input type="color" name="bg_color" value="#FAF9F6" class="w-full h-10 rounded-xl cursor-pointer" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Bordure</label>
                  <input type="color" name="border_color" value="#9B2C2C" class="w-full h-10 rounded-xl cursor-pointer" />
                </div>
              </div>

              <button type="submit" class="w-full rounded-full bg-[var(--color-tc-blue)] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-opacity-90 transition-all">
                Placer sur la carte
              </button>
            </form>
          </div>

          <!-- Ajouter une liaison -->
          <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-lg border border-[var(--color-tc-blue)]/10 p-6">
            <h2 class="text-lg font-bold text-[var(--color-tc-blue)] mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-[var(--color-tc-mustard)]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
              </svg>
              Créer une action (Liaison)
            </h2>
            <form method="POST" class="space-y-4">
              <input type="hidden" name="action" value="add_connection" />
              
              <div class="flex gap-2">
                <div class="flex-1">
                  <label class="block text-xs font-medium text-[var(--color-tc-blue)] mb-1">De *</label>
                  <select name="start_point_id" required class="w-full rounded-xl border-0 py-2 px-2 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 text-xs">
                    <option value="">Sélectionner</option>
                    {routePoints.map(pt => <option value={pt.id}>{pt.location_name}</option>)}
                  </select>
                </div>
                <div class="flex items-end pb-2">
                  <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </div>
                <div class="flex-1">
                  <label class="block text-xs font-medium text-[var(--color-tc-blue)] mb-1">Vers *</label>
                  <select name="end_point_id" required class="w-full rounded-xl border-0 py-2 px-2 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 text-xs">
                    <option value="">Sélectionner</option>
                    {routePoints.map(pt => <option value={pt.id}>{pt.location_name}</option>)}
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Titre de l'action</label>
                <input type="text" name="title" placeholder="Ex: Échange culturel" class="w-full rounded-xl border-0 py-2 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 text-sm" />
              </div>

              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Description</label>
                <textarea name="description" rows="2" class="w-full rounded-xl border-0 py-2 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 text-sm"></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Couleur du tracé</label>
                <div class="flex items-center gap-3">
                  <input type="color" name="color" value="#556B2F" class="w-10 h-10 cursor-pointer bg-[var(--color-tc-cream)] border-0 ring-1 ring-[var(--color-tc-blue)]/20 p-1 rounded" />
                  <span class="text-xs text-gray-500">Ligne et flèche directionnelle</span>
                </div>
              </div>

              <button type="submit" class="w-full rounded-full bg-[var(--color-tc-olive)] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-opacity-90 transition-all" {routePoints.length < 2 ? 'disabled' : ''}>
                Relier les points
              </button>
            </form>
          </div>

        </div>

        <!-- Colonne de droite : La Carte -->
        <div class="lg:col-span-2 flex flex-col gap-4">
          <div class="bg-white rounded-3xl shadow-xl border-2 border-[var(--color-tc-blue)] overflow-hidden relative">
            <div id="map" class="w-full h-[600px] z-0 relative"></div>
            <!-- Overlay chargement -->
            <div id="map-loading" class="absolute inset-0 bg-white/80 z-10 flex items-center justify-center backdrop-blur-sm">
              <div class="text-[var(--color-tc-blue)] font-bold animate-pulse flex items-center gap-2">
                <svg class="animate-spin h-5 w-5 text-[var(--color-tc-red)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                Initialisation de la carte...
              </div>
            </div>
          </div>

          <!-- Liste textuelle pour supprimer si besoin -->
          <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">
             <h3 class="font-bold text-[var(--color-tc-blue)] mb-4">Gestion rapide</h3>
             <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h4 class="text-sm font-bold text-gray-500 mb-2 uppercase tracking-wider">Points ({enrichedPoints.length})</h4>
                  <ul class="space-y-2">
                    {enrichedPoints.map(pt => (
                      <li class="flex items-center justify-between text-sm py-1 border-b border-gray-50">
                        <span class="font-medium">{pt.location_name}</span>
                        <div class="flex items-center gap-2">
                          <button type="button" onclick={`document.getElementById('edit-collabs-${pt.id}').showModal()`} class="text-blue-500 hover:text-blue-700 p-1" title="Modifier les membres">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                          </button>
                          <form method="POST" class="inline" onsubmit="return confirm('Supprimer ce point supprimera aussi les liaisons associées. Poursuivre ?');">
                            <input type="hidden" name="action" value="delete_point" />
                            <input type="hidden" name="point_id" value={pt.id} />
                            <button type="submit" class="text-red-500 hover:text-red-700 p-1">
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                          </form>
                        </div>
                        
                        <!-- Modal de modification -->
                        <dialog id={`edit-collabs-${pt.id}`} class="p-6 rounded-3xl shadow-xl backdrop:bg-black/50 w-full max-w-md border-0 m-auto">
                          <h3 class="text-lg font-bold text-[var(--color-tc-blue)] mb-4">Membres - {pt.location_name}</h3>
                          <form method="POST" class="space-y-4">
                            <input type="hidden" name="action" value="edit_point" />
                            <input type="hidden" name="point_id" value={pt.id} />
                            
                            <div>
                              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Membres avec un compte</label>
                              <div class="max-h-40 overflow-y-auto bg-gray-50 rounded-xl border border-gray-200 p-2 space-y-1">
                                {allProfiles.map(p => (
                                  <label class="flex items-center gap-2 p-1 hover:bg-white rounded cursor-pointer">
                                    <input type="checkbox" name="collaborators[]" value={p.id} checked={(pt.collaborators || []).includes(p.id)} class="rounded text-[var(--color-tc-olive)] focus:ring-[var(--color-tc-olive)]" />
                                    {p.avatar_url ? (
                                       <img src={p.avatar_url} class="w-5 h-5 rounded-full object-cover" />
                                    ) : (
                                       <div class="w-5 h-5 rounded-full bg-gray-200 flex items-center justify-center text-[8px] font-bold">{p.full_name?.charAt(0) || '?'}</div>
                                    )}
                                    <span class="text-sm font-medium text-gray-700">{p.full_name}</span>
                                  </label>
                                ))}
                              </div>
                            </div>

                            <div class="mb-4">
                              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Autres personnes</label>
                              <div id={`ext-collabs-edit-${pt.id}`}>
                                {pt.external_collaborators && pt.external_collaborators.length > 0 ? pt.external_collaborators.map(ext => {
                                  const parts = ext.split(' ');
                                  const first = parts[0] || '';
                                  const last = parts.slice(1).join(' ') || '';
                                  return (
                                    <div class="flex gap-2 mb-2">
                                      <input type="text" name="ext_first_name[]" value={first} placeholder="Prénom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm" />
                                      <input type="text" name="ext_last_name[]" value={last} placeholder="Nom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm" />
                                    </div>
                                  )
                                }) : (
                                  <div class="flex gap-2 mb-2">
                                    <input type="text" name="ext_first_name[]" placeholder="Prénom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm" />
                                    <input type="text" name="ext_last_name[]" placeholder="Nom" class="w-1/2 rounded-xl border-0 py-2.5 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm" />
                                  </div>
                                )}
                              </div>
                              <button type="button" onclick={`addExtCollabRow('ext-collabs-edit-${pt.id}', true)`} class="text-xs text-[var(--color-tc-olive)] hover:underline font-bold">+ Ajouter une autre personne</button>
                            </div>

                            <div class="grid grid-cols-2 gap-4 mt-4">
                              <div>
                                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Couleur de fond</label>
                                <input type="color" name="bg_color" value={pt.bg_color || '#FAF9F6'} class="w-full h-10 rounded-xl cursor-pointer" />
                              </div>
                              <div>
                                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Bordure</label>
                                <input type="color" name="border_color" value={pt.border_color || '#9B2C2C'} class="w-full h-10 rounded-xl cursor-pointer" />
                              </div>
                            </div>

                            <div class="flex justify-end gap-3 mt-6">
                              <button type="button" onclick={`document.getElementById('edit-collabs-${pt.id}').close()`} class="px-4 py-2 text-sm font-medium text-[var(--color-tc-blue)] bg-gray-100 rounded-full hover:bg-gray-200 transition-colors">Annuler</button>
                              <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-[var(--color-tc-blue)] rounded-full hover:bg-opacity-90 transition-colors">Mettre à jour</button>
                            </div>
                          </form>
                        </dialog>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-gray-500 mb-2 uppercase tracking-wider">Liaisons ({routeConnections.length})</h4>
                  <ul class="space-y-2">
                    {routeConnections.map(conn => {
                      const start = routePoints.find(p => p.id === conn.start_point_id)?.location_name || 'Inconnu';
                      const end = routePoints.find(p => p.id === conn.end_point_id)?.location_name || 'Inconnu';
                      return (
                      <li class="flex items-center justify-between text-sm py-1 border-b border-gray-50">
                        <span class="text-gray-600"><span class="font-medium text-gray-900">{start}</span> → <span class="font-medium text-gray-900">{end}</span></span>
                        <div class="flex items-center gap-2">
                          <button type="button" onclick={`document.getElementById('edit-conn-${conn.id}').showModal()`} class="text-blue-500 hover:text-blue-700 p-1" title="Modifier la liaison">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                          </button>
                          <form method="POST" class="inline" onsubmit="return confirm('Supprimer cette liaison ?');">
                            <input type="hidden" name="action" value="delete_connection" />
                            <input type="hidden" name="connection_id" value={conn.id} />
                            <button type="submit" class="text-red-500 hover:text-red-700 p-1">
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                          </form>
                        </div>
                        
                        <!-- Modal de modification de la liaison -->
                        <dialog id={`edit-conn-${conn.id}`} class="p-6 rounded-3xl shadow-xl backdrop:bg-black/50 w-full max-w-md border-0 m-auto">
                          <h3 class="text-lg font-bold text-[var(--color-tc-blue)] mb-4">Modifier la liaison</h3>
                          <form method="POST" class="space-y-4">
                            <input type="hidden" name="action" value="edit_connection" />
                            <input type="hidden" name="connection_id" value={conn.id} />
                            
                            <div>
                              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Titre de l'action</label>
                              <input type="text" name="title" value={conn.title} class="w-full rounded-xl border-0 py-2 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm" />
                            </div>

                            <div>
                              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Description</label>
                              <textarea name="description" rows="2" class="w-full rounded-xl border-0 py-2 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm">{conn.description}</textarea>
                            </div>

                            <div>
                              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-1">Couleur du tracé</label>
                              <div class="flex items-center gap-3">
                                <input type="color" name="color" value={conn.color || '#556B2F'} class="w-10 h-10 cursor-pointer bg-gray-50 border-0 ring-1 ring-gray-200 p-1 rounded" />
                                <span class="text-xs text-gray-500">Ligne et flèche directionnelle</span>
                              </div>
                            </div>

                            <div class="flex justify-end gap-3 mt-6">
                              <button type="button" onclick={`document.getElementById('edit-conn-${conn.id}').close()`} class="px-4 py-2 text-sm font-medium text-[var(--color-tc-blue)] bg-gray-100 rounded-full hover:bg-gray-200 transition-colors">Annuler</button>
                              <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-[var(--color-tc-blue)] rounded-full hover:bg-opacity-90 transition-colors">Mettre à jour</button>
                            </div>
                          </form>
                        </dialog>
                      </li>
                    )})}
                  </ul>
                </div>
             </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Script Leaflet depuis CDN -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  
  <!-- Variables pour la carte -->
  <script is:inline define:vars={{ enrichedPoints, routeConnections }}>
    window.tcMapPoints = enrichedPoints;
    window.tcMapConnections = routeConnections;
  </script>

  <!-- Logique de la carte -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Initialiser la carte Leaflet
      // On centre globalement sur l'Europe/Afrique par défaut
      const map = L.map('map', {
        zoomControl: false, // On désactive pour le mettre ailleurs
        attributionControl: false // Cacher l'attribution
      }).setView([20, 0], 2); 
      
      // Contrôle de zoom en bas à droite
      L.control.zoom({ position: 'bottomright' }).addTo(map);

      // 2. Fond de carte Esri WorldGrayCanvas
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
        maxZoom: 16
      }).addTo(map);

      const points = window.tcMapPoints || [];
      const connections = window.tcMapConnections || [];
      const markers = {};

      const tcRed = '#9B2C2C';
      const tcMustard = '#D69E2E';
      const tcCream = '#FAF9F6';
      const tcBlue = '#2A4365';

      // Fonction pour générer une courbe douce (Bézier quadratique)
      function getBezierCurve(latlng1, latlng2, offsetFactor = 0.2) {
        const p1 = map.project(latlng1, 10);
        const p2 = map.project(latlng2, 10);
        
        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const ctrlP = L.point(
          (p1.x + p2.x) / 2 - dy * offsetFactor,
          (p1.y + p2.y) / 2 + dx * offsetFactor
        );

        const points = [];
        const numSteps = 20;
        for (let i = 0; i <= numSteps; i++) {
          const t = i / numSteps;
          const u = 1 - t;
          const x = u * u * p1.x + 2 * u * t * ctrlP.x + t * t * p2.x;
          const y = u * u * p1.y + 2 * u * t * ctrlP.y + t * t * p2.y;
          points.push(map.unproject(L.point(x, y), 10));
        }
        return points;
      }

      function getInitials(name) {
        if (!name) return '?';
        const parts = name.trim().split(' ').filter(p => p.length > 0);
        if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return '?';
      }

      connections.forEach(conn => {
        try {
          const startPt = points.find(p => p.id === conn.start_point_id);
          const endPt = points.find(p => p.id === conn.end_point_id);
          
          if (startPt && endPt) {
            const curvePoints = getBezierCurve(
              [startPt.latitude, startPt.longitude], 
              [endPt.latitude, endPt.longitude]
            );

            // Couleur personnalisée
            const lineColor = conn.color || '#556B2F';

            // Raccourcir le point final géographiquement (calculé au zoom 3)
            const ptA = map.project(curvePoints[19], 3);
            const ptB = map.project(curvePoints[20], 3);
            const angle = Math.atan2(ptB.y - ptA.y, ptB.x - ptA.x);
            const angleDeg = angle * (180 / Math.PI);

            // On recule le point de 25 pixels (au zoom 3)
            const offsetPx = 25;
            const newPtB = L.point(
              ptB.x - Math.cos(angle) * offsetPx,
              ptB.y - Math.sin(angle) * offsetPx
            );
            const arrowLatLng = map.unproject(newPtB, 3);
            
            // On remplace la fin de la courbe par ce point raccourci
            curvePoints[20] = arrowLatLng;

            const polyline = L.polyline(curvePoints, {
              color: lineColor,
              weight: 5,
              opacity: 0.9,
              lineJoin: 'round'
            }).addTo(map);

            if (conn.title || conn.description) {
              const htmlContent = `
                <div class="p-1 w-[200px] whitespace-normal">
                  <h3 class="font-bold text-[var(--color-tc-blue)] text-sm">${conn.title || 'Action'}</h3>
                  ${conn.description ? `<p class="text-xs text-gray-600 mt-1 break-words">${conn.description}</p>` : ''}
                </div>
              `;
              const tooltipOptions = { sticky: true, className: 'bg-white rounded-xl shadow-lg border-0' };
              polyline.bindTooltip(htmlContent, tooltipOptions);
              polyline.bindPopup(htmlContent);

              polyline.on('popupopen', function() { this.unbindTooltip(); });
              polyline.on('popupclose', function() { this.bindTooltip(htmlContent, tooltipOptions); });
            }

            const arrowIcon = L.divIcon({
              html: `<svg viewBox="0 0 24 24" width="24" height="24" style="transform: rotate(${angleDeg}deg); transform-origin: center; filter: drop-shadow(0px 2px 2px rgba(0,0,0,0.3));">
                      <polygon points="4,4 20,12 4,20" fill="${lineColor}" />
                     </svg>`,
              className: '',
              iconSize: [24, 24],
              iconAnchor: [12, 12]
            });
            const arrow = L.marker(arrowLatLng, { icon: arrowIcon, interactive: false, zIndexOffset: 100 }).addTo(map);

            // Popup sur la ligne
            if (conn.title || conn.description) {
              polyline.bindPopup(`
                <div class="p-2 min-w-[200px]">
                  <strong class="block text-[#2A4365] mb-1">${conn.title || 'Action'}</strong>
                  <p class="text-xs text-gray-600">${conn.description || ''}</p>
                </div>
              `);
            }
          }
        } catch(e) {
          console.error("Erreur avec la connexion: ", e);
        }
      });

      // 4. Placer les points (Marqueurs personnalisés)
      points.forEach(pt => {
        // Construction du HTML pour le marqueur (un cercle coloré)
        const markerHtml = `
          <div style="
            width: 24px; height: 24px; 
            background-color: ${pt.bg_color || tcCream}; 
            border: 4px solid ${pt.border_color || tcRed}; 
            border-radius: 50%; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.2s;
          " class="tc-marker hover:scale-125"></div>
        `;
        
        const customIcon = L.divIcon({
          html: markerHtml,
          className: '', // Évite les styles par défaut de Leaflet
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          popupAnchor: [0, -12]
        });

        const marker = L.marker([pt.latitude, pt.longitude], { icon: customIcon }).addTo(map);
        markers[pt.id] = marker;

        // Construction du Popup interactif
        // Construction de l'infobulle au survol
        let collabsHtml = '';
        if (pt.collabsData && pt.collabsData.length > 0) {
          collabsHtml = `<div class="mt-3 border-t pt-2"><div class="flex -space-x-2 overflow-hidden">`;
          pt.collabsData.forEach(c => {
            const safeName = encodeURIComponent(c.full_name || '');
            const safeBio = encodeURIComponent(c.description || '');
            if (c.avatar_url) {
              collabsHtml += `<img src="${c.avatar_url}" title="${c.full_name}" onclick="openCollabModal('${safeName}', '${c.avatar_url}', '${safeBio}')" class="inline-block h-12 w-12 rounded-full ring-2 ring-white object-cover shadow-sm cursor-pointer hover:scale-110 transition-transform" />`;
            } else {
              collabsHtml += `<div title="${c.full_name}" onclick="openCollabModal('${safeName}', null, '${safeBio}')" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gray-200 ring-2 ring-white text-xs font-bold text-gray-700 shadow-sm cursor-pointer hover:scale-110 transition-transform">${getInitials(c.full_name)}</div>`;
            }
          });
          collabsHtml += `</div></div>`;
        }

        const popupHtml = `
          <div class="p-1 min-w-[150px]">
            <h3 class="font-bold text-[#2A4365] text-sm">${pt.location_name}</h3>
            ${collabsHtml}
          </div>
        `;
        const tooltipOptions = { direction: 'top', offset: [0, -12], className: 'bg-white rounded-xl shadow-lg border-0' };
        marker.bindTooltip(popupHtml, tooltipOptions);
        marker.bindPopup(popupHtml, { offset: [0, -12] });

        marker.on('popupopen', function() { this.unbindTooltip(); });
        marker.on('popupclose', function() { this.bindTooltip(popupHtml, tooltipOptions); });
      });

      // Ajuster la vue pour voir tous les points si la carte n'est pas vide
      if (points.length > 0) {
        const group = new L.featureGroup(Object.values(markers));
        map.fitBounds(group.getBounds(), { padding: [50, 50], maxZoom: 12 });
      }

      // Masquer le loader
      document.getElementById('map-loading').style.display = 'none';
    });
  </script>

  <!-- Modal Collaborateur -->
  <dialog id="collab-modal" class="p-0 rounded-3xl shadow-2xl backdrop:bg-black/50 w-full max-w-sm border-0 m-auto bg-transparent" style="z-index: 9999;">
    <div class="bg-white rounded-3xl overflow-hidden relative">
      <button onclick="document.getElementById('collab-modal').close()" class="absolute top-4 right-4 bg-gray-100/80 hover:bg-gray-200 p-2 rounded-full z-10 transition-colors">
        <svg class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div class="bg-gradient-to-r from-[var(--color-tc-blue)] to-[#3A5385] h-24 w-full"></div>
      <div class="px-6 pb-6 relative">
        <div class="-mt-12 flex justify-center mb-4">
          <img id="collab-modal-avatar" src="" class="w-24 h-24 rounded-full border-4 border-white object-cover shadow-md hidden" />
          <div id="collab-modal-initials" class="w-24 h-24 rounded-full border-4 border-white bg-gray-200 flex items-center justify-center text-2xl font-bold text-gray-700 shadow-md hidden"></div>
        </div>
        <h3 id="collab-modal-name" class="text-xl font-bold text-center text-[var(--color-tc-blue)] mb-2"></h3>
        <p id="collab-modal-bio" class="text-sm text-gray-600 text-center leading-relaxed"></p>
      </div>
    </div>
  </dialog>

  <script is:inline>
    function addExtCollabRow(containerId, isEdit = false) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const div = document.createElement('div');
      div.className = 'flex gap-2 mb-2';
      const inputClass = isEdit 
        ? 'w-1/2 rounded-xl border-0 py-2.5 px-4 bg-gray-50 ring-1 ring-gray-200 focus:ring-2 focus:ring-[var(--color-tc-blue)] text-sm'
        : 'w-1/2 rounded-xl border-0 py-2.5 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-sm';
        
      div.innerHTML = `
        <input type="text" name="ext_first_name[]" placeholder="Prénom" class="${inputClass}" />
        <input type="text" name="ext_last_name[]" placeholder="Nom" class="${inputClass}" />
      `;
      container.appendChild(div);
    }

    window.openCollabModal = function(encodedName, avatarUrl, encodedBio) {
      const name = encodedName ? decodeURIComponent(encodedName) : 'Membre';
      const bio = encodedBio && encodedBio !== 'null' && encodedBio !== 'undefined' ? decodeURIComponent(encodedBio) : '';
      
      document.getElementById('collab-modal-name').textContent = name;
      
      const bioEl = document.getElementById('collab-modal-bio');
      if (bio) {
        bioEl.textContent = bio;
        bioEl.classList.remove('hidden');
      } else {
        bioEl.textContent = '';
        bioEl.classList.add('hidden');
      }
      
      const avatarImg = document.getElementById('collab-modal-avatar');
      const initialsDiv = document.getElementById('collab-modal-initials');
      
      if (avatarUrl && avatarUrl !== 'null' && avatarUrl !== 'undefined') {
        avatarImg.src = avatarUrl;
        avatarImg.classList.remove('hidden');
        initialsDiv.classList.add('hidden');
      } else {
        avatarImg.classList.add('hidden');
        
        let initials = '?';
        if (name) {
          const parts = name.trim().split(' ').filter(p => p.length > 0);
          if (parts.length >= 2) initials = (parts[0][0] + parts[1][0]).toUpperCase();
          else if (parts.length === 1) initials = parts[0].substring(0, 2).toUpperCase();
        }
        
        initialsDiv.textContent = initials;
        initialsDiv.classList.remove('hidden');
      }
      
      document.getElementById('collab-modal').showModal();
    };
  </script>

  <style is:global>
    /* Supprime la bordure de focus par défaut sur les éléments interactifs SVG (lignes/flèches) */
    .leaflet-interactive:focus {
      outline: none !important;
    }
  </style>
</Layout>
