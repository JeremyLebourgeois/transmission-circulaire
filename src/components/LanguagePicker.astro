---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
// Clean the URL pathname to construct paths properly for language switching
const cleanPath = Astro.url.pathname.replace(new RegExp(`^/${currentLang}(/|$)`), '/');
const currentPath = cleanPath === '/' ? '' : cleanPath;
---
<div class="relative group">
  <button class="flex items-center space-x-1 text-sm font-medium uppercase hover:text-[var(--color-tc-mustard)] transition-colors focus:outline-none">
    <span>{currentLang}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  <div class="absolute right-0 mt-2 w-36 bg-white dark:bg-slate-800 rounded-xl shadow-xl py-2 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right scale-95 group-hover:scale-100 border border-slate-200 dark:border-slate-700">
    {Object.entries(languages).map(([lang, label]) => (
      <a 
        href={lang === 'fr' ? (currentPath || '/') : `/${lang}${currentPath}`} 
        class={`block px-4 py-2 text-sm transition-colors ${lang === currentLang ? 'font-bold text-[var(--color-tc-blue)] dark:text-white bg-slate-50 dark:bg-slate-700/50' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-[var(--color-tc-mustard)] dark:hover:text-[var(--color-tc-mustard)]'}`}
      >
        {label}
      </a>
    ))}
  </div>
</div>
