---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<div class="relative overflow-hidden bg-[var(--color-tc-cream)] isolate transition-colors duration-500">
 <!-- Decorative background -->
 <div class="absolute inset-x-0 top-0 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
 <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[var(--color-tc-mustard)] via-[var(--color-tc-olive)] to-[var(--color-tc-blue)] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
 </div>
 
 <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:flex lg:px-8 lg:py-24">

 <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-xl lg:flex-shrink-0 lg:pt-8 flex flex-col justify-center">
 <div class="mt-10 flex items-center gap-4 sm:gap-6">
 <div class="relative w-12 h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 flex-shrink-0 rounded-full border-2 border-[var(--color-tc-mustard)]/30 shadow-md overflow-hidden bg-white">
 <img src="/logo.jpeg" alt="Logo" class="w-full h-full object-cover" />
 </div>
 <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] leading-[1.1]">
 {t('hero.title')}
 </h1>
 </div>
 <p class="mt-6 text-lg leading-8 text-[var(--color-tc-blue)]/80 ">
 {t('hero.subtitle')}
 </p>
 <div class="mt-10 flex flex-wrap items-center gap-4 sm:gap-6">
 <a href={translatePath('/about')} class="rounded-full bg-[var(--color-tc-olive)] px-6 py-3 text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-tc-olive)]">
 {t('hero.cta.discover')}
 </a>
 <a href={translatePath('/donate')} class="text-sm font-semibold leading-6 text-[var(--color-tc-mustard)] hover:text-opacity-80 group flex items-center gap-2">
 {t('hero.cta.support')}
 <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
 </a>
 </div>
 </div>
 <div class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none lg:flex-none xl:ml-32">
 <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
 <div class="rounded-3xl p-2 lg:p-4 relative">
 <!-- Main visual could go here, replacing this placeholder -->
 <img src="/home.jpeg" alt="Transmission Circulaire Accueil" class="w-[30rem] lg:w-[40rem] rounded-3xl shadow-2xl object-cover border border-white/50" />
 </div>
 </div>
 </div>
 </div>
</div>
