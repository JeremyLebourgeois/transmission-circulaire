---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../BookCard.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: books } = await supabase
  .from('books')
  .select('*')
  .order('created_at', { ascending: false });

// Check if current user is admin
const { data: { user } } = await supabase.auth.getUser();
let userRole = '';
if (user) {
  const { data: roleData } = await supabase.from('user_roles').select('role').eq('id', user.id).single();
  userRole = roleData?.role || '';
}
---

<Layout title={t('nav.books')}>
 <div class="bg-[var(--color-tc-cream)] py-24 sm:py-32">
 <div class="mx-auto max-w-7xl px-6 lg:px-8">
 <div class="mx-auto max-w-2xl text-center">
 <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">{t('nav.books')}</h2>
 <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/80 ">
 {t('books.description')}
 </p>
  {(userRole === 'admin' || userRole === 'super_admin') && (
    <a href={translatePath('/dashboard/books')} class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-tc-mustard)] px-5 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-opacity-90 transition-all transform hover:-translate-y-0.5">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      {t('books.manage')}
    </a>
  )}
 </div>
  <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
  {books?.map(book => (
  <BookCard 
    title={book.title}
    coverImage={book.main_image_url || '/logo.jpeg'}
    description={book.short_description}
    link={translatePath(`/books/${book.id}`)}
  />
  ))}
  </div>
 </div>
 </div>
</Layout>
