---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user }, error: userError } = await supabase.auth.getUser();

if (!user || userError) {
  return Astro.redirect(translatePath('/login'));
}

const { data: roleData } = await supabase
  .from('user_roles')
  .select('role')
  .eq('id', user.id)
  .single();

const userRole = roleData?.role || '';
if (userRole !== 'admin' && userRole !== 'super_admin') {
  return Astro.redirect(translatePath('/dashboard'));
}

let successMessage = '';
let errorMessage = '';

// Handle form submission (add new event or delete)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();

    if (action === 'delete') {
      const eventId = formData.get('eventId')?.toString();
      const { error } = await supabase.from('events').delete().eq('id', eventId);
      if (error) throw error;
      successMessage = 'Événement supprimé avec succès.';
    } else {
      // Add event
      const title = formData.get('title')?.toString() || '';
      const date = formData.get('date')?.toString() || '';
      const endDate = formData.get('end_date')?.toString() || null;
      const location = formData.get('location')?.toString() || '';
      const description = formData.get('description')?.toString() || '';
      const mainImageFile = formData.get('image') as File;

      let imageUrl = '';
      if (mainImageFile && mainImageFile.size > 0) {
        const fileExt = mainImageFile.name.split('.').pop();
        const fileName = `${Date.now()}-event.${fileExt}`;
        const { error: uploadError } = await supabase.storage
          .from('events_images')
          .upload(fileName, mainImageFile, { upsert: true });
        
        if (uploadError) {
          // If the bucket doesn't exist, we will just skip the image or throw.
          // Supabase might throw an error if 'events_images' bucket is missing.
          throw uploadError;
        }
        
        const { data: { publicUrl } } = supabase.storage.from('events_images').getPublicUrl(fileName);
        imageUrl = publicUrl;
      }

      const { data: newEvent, error: eventError } = await supabase
        .from('events')
        .insert({ title, date, end_date: endDate, location, description, image_url: imageUrl })
        .select()
        .single();
        
      if (eventError) throw eventError;

      successMessage = 'Événement ajouté avec succès !';
    }
  } catch (err: any) {
    errorMessage = 'Erreur : ' + (err?.message || JSON.stringify(err));
  }
}

// Fetch existing events
const { data: events, error: fetchError } = await supabase
  .from('events')
  .select('*')
  .order('date', { ascending: false });

let dbMissing = false;
if (fetchError && fetchError.code === '42P01') { // table does not exist
  dbMissing = true;
}
---

<Layout title="Gestion des Événements | Admin">
  <main class="min-h-screen bg-[var(--color-tc-cream)] py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Header -->
      <div class="flex items-center gap-4">
        <a href={translatePath('/dashboard')} class="text-[var(--color-tc-blue)]/60 hover:text-[var(--color-tc-blue)] transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </a>
        <h1 class="text-3xl font-display font-bold text-[var(--color-tc-blue)]">📅 Gestion des Événements</h1>
      </div>

      {dbMissing && (
        <div class="bg-red-50 text-red-800 p-6 rounded-xl text-sm font-medium border border-red-200">
          <h2 class="text-lg font-bold mb-2">Configuration de la base de données requise</h2>
          <p class="mb-4">La table <code>events</code> n'existe pas encore dans votre base Supabase.</p>
          <p>Veuillez exécuter le script SQL fourni dans l'éditeur SQL de Supabase pour créer la table avant d'ajouter des événements.</p>
        </div>
      )}

      {successMessage && <div class="bg-green-50 text-green-800 p-4 rounded-xl text-sm font-medium border border-green-200">{successMessage}</div>}
      {errorMessage && !dbMissing && <div class="bg-red-50 text-red-800 p-4 rounded-xl text-sm font-medium border border-red-200">{errorMessage}</div>}

      <!-- Add Event Form -->
      {!dbMissing && (
        <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-xl border border-[var(--color-tc-blue)]/10 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6">Ajouter un nouvel événement</h2>
          <form method="POST" enctype="multipart/form-data" class="space-y-6">

            <!-- Titre -->
            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Nom de l'événement *</label>
              <input type="text" name="title" required placeholder="Ex: Vernissage exposition" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
            </div>

            <!-- Dates -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Date et Heure de début *</label>
                <input type="datetime-local" name="date" required class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Date et Heure de fin (Optionnel)</label>
                <input type="datetime-local" name="end_date" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
            </div>

            <!-- Lieu + Image -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Lieu *</label>
                <input type="text" name="location" required placeholder="Ex: Paris, France" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Image d'illustration (optionnel)</label>
                <input type="file" name="image" accept="image/*" class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[var(--color-tc-mustard)]/10 file:text-[var(--color-tc-mustard)] hover:file:bg-[var(--color-tc-mustard)]/20" />
              </div>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Description / Informations additionnelles</label>
              <textarea name="description" rows="4" placeholder="Détails de l'événement, lien de réservation..." class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm"></textarea>
            </div>

            <div class="pt-4">
              <button type="submit" class="w-full sm:w-auto rounded-full bg-[var(--color-tc-olive)] px-8 py-3 text-sm font-bold text-white shadow-sm hover:bg-opacity-90 transition-all transform hover:-translate-y-0.5">
                Ajouter l'événement
              </button>
            </div>
          </form>
        </div>
      )}

      <!-- Existing Events -->
      {!dbMissing && (
        <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-xl border border-[var(--color-tc-blue)]/10 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6">Événements programmés ({events?.length || 0})</h2>
          {events?.length === 0 && <p class="text-[var(--color-tc-blue)]/50 italic text-sm">Aucun événement pour l'instant. Ajoutez-en un ci-dessus !</p>}
          
          <div class="space-y-4">
            {events?.map(evt => (
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 rounded-2xl bg-[var(--color-tc-cream)] border border-[var(--color-tc-blue)]/5">
                {evt.image_url ? (
                  <img src={evt.image_url} alt={evt.title} class="w-16 h-16 object-cover rounded-xl flex-shrink-0" />
                ) : (
                  <div class="w-16 h-16 rounded-xl bg-[var(--color-tc-blue)]/5 flex items-center justify-center flex-shrink-0">
                    <svg class="w-8 h-8 text-[var(--color-tc-blue)]/20" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                  </div>
                )}
                
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-[var(--color-tc-blue)] truncate">{evt.title}</h3>
                  <p class="text-sm text-[var(--color-tc-blue)]/70 mt-1">
                    {evt.end_date ? (
                      <>Du {new Date(evt.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' })} au {new Date(evt.end_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' })}</>
                    ) : (
                      <>{new Date(evt.date).toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute:'2-digit' })}</>
                    )}
                  </p>
                  <p class="text-xs text-[var(--color-tc-blue)]/50 mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    {evt.location}
                  </p>
                </div>
                
                <div class="flex items-baseline gap-3 flex-shrink-0 mt-4 sm:mt-0">
                  <a href={translatePath(`/events/${evt.id}`)} target="_blank" class="text-xs text-[var(--color-tc-blue)]/60 hover:text-[var(--color-tc-blue)] underline">Voir →</a>
                  <form method="POST" class="m-0 p-0 flex items-baseline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="eventId" value={evt.id} />
                    <button type="submit" onclick="return confirm('Supprimer cet événement définitivement ?')" class="text-xs text-red-500 hover:text-red-700 underline leading-none py-2 px-3 bg-red-50 rounded-lg border border-red-100 hover:bg-red-100 transition-colors">Supprimer</button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </main>
</Layout>
