---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const supabase = getSupabaseServerClient(Astro.cookies);
const { data: { user }, error: userError } = await supabase.auth.getUser();

if (!user || userError) {
  return Astro.redirect(translatePath('/login'));
}

const { data: roleData } = await supabase
  .from('user_roles')
  .select('role')
  .eq('id', user.id)
  .single();

const userRole = roleData?.role || '';
if (userRole !== 'admin' && userRole !== 'super_admin') {
  return Astro.redirect(translatePath('/dashboard'));
}

const successParam = Astro.url.searchParams.get('success');
let successMessage = '';
if (successParam === 'added') successMessage = 'Événement ajouté avec succès !';
if (successParam === 'deleted') successMessage = 'Événement supprimé avec succès.';
let errorMessage = '';

const editId = Astro.url.searchParams.get('edit');
let eventToEdit = null;
if (editId) {
  const { data } = await supabase.from('events').select('*').eq('id', editId).single();
  if (data) eventToEdit = data;
}

const formatForInput = (isoString) => {
  if (!isoString) return '';
  return new Date(isoString).toISOString().slice(0, 16);
};

// Handle form submission (add new event or delete)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();

    if (action === 'delete') {
      const eventId = formData.get('eventId')?.toString();
      const { error } = await supabase.from('events').delete().eq('id', eventId);
      if (error) throw error;
      successMessage = 'Événement supprimé avec succès.';
    } else if (action === 'update') {
      // Update event
      const eventId = formData.get('eventId')?.toString();
      const title = formData.get('title')?.toString() || '';
      const date = formData.get('date')?.toString() || '';
      const endDate = formData.get('end_date')?.toString() || null;
      const location = formData.get('location')?.toString() || '';
      const description = formData.get('description')?.toString() || '';
      const mainImageFile = formData.get('image') as File;

      const updateData: any = { title, date, end_date: endDate, location, description };

      if (mainImageFile && mainImageFile.size > 0) {
        const fileExt = mainImageFile.name.split('.').pop();
        const fileName = `${Date.now()}-event.${fileExt}`;
        const { error: uploadError } = await supabase.storage
          .from('events_images')
          .upload(fileName, mainImageFile, { upsert: true });
        
        if (uploadError) throw uploadError;
        
        const { data: { publicUrl } } = supabase.storage.from('events_images').getPublicUrl(fileName);
        updateData.image_url = publicUrl;
      }

      const maxSpotsRaw = formData.get('max_spots')?.toString();
      let maxSpots = maxSpotsRaw ? parseInt(maxSpotsRaw, 10) : null;
      const audience = formData.get('audience')?.toString() || 'all';

      // Vérification du nombre d'inscrits actuels
      const { count: currentRegistrations, error: countError } = await supabase
        .from('event_registrations')
        .select('*', { count: 'exact', head: true })
        .eq('event_id', eventId);
      
      if (countError) throw countError;
      
      if (maxSpots !== null && currentRegistrations !== null && maxSpots < currentRegistrations) {
        throw new Error(`Impossible de définir la limite à ${maxSpots}. Il y a déjà ${currentRegistrations} inscrit(s).`);
      }

      updateData.max_spots = maxSpots;
      updateData.audience = audience;
      const priceRaw = formData.get('price')?.toString();
      updateData.price = priceRaw ? parseFloat(priceRaw) : 0;
      updateData.ticket_url = formData.get('ticket_url')?.toString() || null;

      const { error: eventError } = await supabase.from('events').update(updateData).eq('id', eventId);
      if (eventError) throw eventError;

      successMessage = 'Événement mis à jour avec succès !';
      eventToEdit = null;
    } else {
      // Add event
      const title = formData.get('title')?.toString() || '';
      const date = formData.get('date')?.toString() || '';
      const endDate = formData.get('end_date')?.toString() || null;
      const location = formData.get('location')?.toString() || '';
      const description = formData.get('description')?.toString() || '';
      const mainImageFile = formData.get('image') as File;

      let imageUrl = '';
      if (mainImageFile && mainImageFile.size > 0) {
        const fileExt = mainImageFile.name.split('.').pop();
        const fileName = `${Date.now()}-event.${fileExt}`;
        const { error: uploadError } = await supabase.storage
          .from('events_images')
          .upload(fileName, mainImageFile, { upsert: true });
        
        if (uploadError) {
          throw uploadError;
        }
        
        const { data: { publicUrl } } = supabase.storage.from('events_images').getPublicUrl(fileName);
        imageUrl = publicUrl;
      }

      const maxSpotsRaw = formData.get('max_spots')?.toString();
      const maxSpots = maxSpotsRaw ? parseInt(maxSpotsRaw, 10) : null;
      const audience = formData.get('audience')?.toString() || 'all';
      const priceRaw = formData.get('price')?.toString();
      const price = priceRaw ? parseFloat(priceRaw) : 0;
      const ticketUrl = formData.get('ticket_url')?.toString() || null;

      const { data: newEvent, error: eventError } = await supabase
        .from('events')
        .insert({ title, date, end_date: endDate, location, description, image_url: imageUrl, max_spots: maxSpots, audience, price, ticket_url: ticketUrl })
        .select()
        .single();
        
      if (eventError) throw eventError;

      successMessage = 'Événement ajouté avec succès !';
    }
  } catch (err: any) {
    errorMessage = 'Erreur : ' + (err?.message || JSON.stringify(err));
  }
}

// Fetch existing events
const { data: events, error: fetchError } = await supabase
  .from('events')
  .select('*')
  .order('date', { ascending: false });

let dbMissing = false;
if (fetchError && fetchError.code === '42P01') { // table does not exist
  dbMissing = true;
}
---

<Layout title="Gestion des Événements | Admin">
  <main class="min-h-screen bg-[var(--color-tc-cream)] py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Header -->
      <div class="flex items-center gap-4">
        <a href={translatePath('/dashboard')} class="text-[var(--color-tc-blue)]/60 hover:text-[var(--color-tc-blue)] transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </a>
        <h1 class="text-3xl font-display font-bold text-[var(--color-tc-blue)]">📅 Gestion des Événements</h1>
      </div>

      {dbMissing && (
        <div class="bg-red-50 text-red-800 p-6 rounded-xl text-sm font-medium border border-red-200">
          <h2 class="text-lg font-bold mb-2">Configuration de la base de données requise</h2>
          <p class="mb-4">La table <code>events</code> n'existe pas encore dans votre base Supabase.</p>
          <p>Veuillez exécuter le script SQL fourni dans l'éditeur SQL de Supabase pour créer la table avant d'ajouter des événements.</p>
        </div>
      )}

      {successMessage && <div class="bg-green-50 text-green-800 p-4 rounded-xl text-sm font-medium border border-green-200">{successMessage}</div>}
      {errorMessage && !dbMissing && <div class="bg-red-50 text-red-800 p-4 rounded-xl text-sm font-medium border border-red-200">{errorMessage}</div>}

      <!-- Add Event Form -->
      {!dbMissing && (
        <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-xl border border-[var(--color-tc-blue)]/10 p-6 sm:p-8" id="event-form">
          <h2 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6">{eventToEdit ? "Modifier l'événement" : "Ajouter un nouvel événement"}</h2>
          <form method="POST" enctype="multipart/form-data" class="space-y-6" onsubmit="const btn = this.querySelector('button[type=submit]'); btn.disabled = true; btn.innerText = 'Traitement en cours...';">
            <input type="hidden" name="action" value={eventToEdit ? "update" : "add"} />
            {eventToEdit && <input type="hidden" name="eventId" value={eventToEdit.id} />}
            
            <!-- Titre -->
            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Nom de l'événement *</label>
              <input type="text" name="title" required value={eventToEdit?.title || ''} placeholder="Ex: Vernissage exposition" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
            </div>

            <!-- Dates -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Date et Heure de début *</label>
                <input type="datetime-local" name="date" required value={formatForInput(eventToEdit?.date)} class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Date et Heure de fin (Optionnel)</label>
                <input type="datetime-local" name="end_date" value={formatForInput(eventToEdit?.end_date)} class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
            </div>

            <!-- Lieu + Image -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Lieu *</label>
                <input type="text" name="location" required value={eventToEdit?.location || ''} placeholder="Ex: Paris, France" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Image d'illustration (optionnel)</label>
                <input type="file" name="image" accept="image/*" class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[var(--color-tc-mustard)]/10 file:text-[var(--color-tc-mustard)] hover:file:bg-[var(--color-tc-mustard)]/20" />
                {eventToEdit?.image_url && <p class="text-xs text-[var(--color-tc-blue)]/50 mt-1">L'image actuelle sera conservée si vous n'en sélectionnez pas de nouvelle.</p>}
              </div>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Description / Informations additionnelles</label>
              <textarea name="description" rows="4" placeholder="Détails de l'événement, lien de réservation..." class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm">{eventToEdit?.description || ''}</textarea>
            </div>

            <!-- Infos Additionnelles: Places et Audience -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Nombre de places max (optionnel)</label>
                <input type="number" min="1" name="max_spots" value={eventToEdit?.max_spots || ''} placeholder="Laisser vide si illimité" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Public autorisé *</label>
                <select name="audience" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm">
                  <option value="all" selected={eventToEdit?.audience !== 'collaborator_only'}>Ouvert à tous</option>
                  <option value="collaborator_only" selected={eventToEdit?.audience === 'collaborator_only'}>Réservé aux adhérents</option>
                </select>
              </div>
            </div>

            <!-- Prix & Billetterie -->
            <div class="border-t border-[var(--color-tc-blue)]/10 pt-6">
              <h3 class="text-md font-bold text-[var(--color-tc-blue)] mb-4">Prix & Billetterie</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Prix (€) <span class="text-[var(--color-tc-blue)]/50 font-normal">— laisser 0 pour gratuit</span></label>
                  <input type="number" min="0" step="0.01" name="price" value={eventToEdit?.price ?? '0'} placeholder="0" class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Lien de billetterie HelloAsso <span class="text-[var(--color-tc-blue)]/50 font-normal">(optionnel)</span></label>
                  <div class="flex gap-2">
                    <input type="url" name="ticket_url" value={eventToEdit?.ticket_url || ''} placeholder="https://www.helloasso.com/..." class="flex-1 rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] text-sm" />
                    <a href="https://admin.helloasso.com/transmission-circulaire/evenements/creation" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-2 bg-[var(--color-tc-mustard)] text-[var(--color-tc-blue)] rounded-xl text-xs font-bold hover:bg-opacity-90 transition-all" title="Créer la billetterie sur HelloAsso">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                      Créer la billetterie
                    </a>
                  </div>
                  <p class="text-xs text-[var(--color-tc-blue)]/50 mt-1">Si vide et prix > 0, "Règlement sur place" sera affiché.</p>
                </div>
              </div>
            </div>

            <div class="pt-4 flex items-center gap-4">
              <button type="submit" class="w-full sm:w-auto rounded-full bg-[var(--color-tc-olive)] px-8 py-3 text-sm font-bold text-white shadow-sm hover:bg-opacity-90 transition-all transform hover:-translate-y-0.5">
                {eventToEdit ? "Enregistrer les modifications" : "Ajouter l'événement"}
              </button>
              {eventToEdit && (
                <a href={translatePath('/dashboard/events')} class="text-sm font-bold text-[var(--color-tc-blue)] hover:underline">
                  Annuler
                </a>
              )}
            </div>
          </form>
        </div>
      )}

      <!-- Existing Events -->
      {!dbMissing && (
        <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-xl border border-[var(--color-tc-blue)]/10 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6">Événements programmés ({events?.length || 0})</h2>
          {events?.length === 0 && <p class="text-[var(--color-tc-blue)]/50 italic text-sm">Aucun événement pour l'instant. Ajoutez-en un ci-dessus !</p>}
          
          <div class="space-y-4">
            {events?.map(evt => (
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 rounded-2xl bg-[var(--color-tc-cream)] border border-[var(--color-tc-blue)]/5">
                {evt.image_url ? (
                  <img src={evt.image_url} alt={evt.title} class="w-16 h-16 object-cover rounded-xl flex-shrink-0" />
                ) : (
                  <div class="w-16 h-16 rounded-xl bg-[var(--color-tc-blue)]/5 flex items-center justify-center flex-shrink-0">
                    <svg class="w-8 h-8 text-[var(--color-tc-blue)]/20" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                  </div>
                )}
                
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-[var(--color-tc-blue)] truncate">{evt.title}</h3>
                  <p class="text-sm text-[var(--color-tc-blue)]/70 mt-1">
                    {evt.end_date ? (
                      <>Du {new Date(evt.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' })} au {new Date(evt.end_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit' })}</>
                    ) : (
                      <>{new Date(evt.date).toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute:'2-digit' })}</>
                    )}
                  </p>
                  <p class="text-xs text-[var(--color-tc-blue)]/50 mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    {evt.location}
                  </p>
                </div>
                
                <div class="flex items-baseline gap-3 flex-shrink-0 mt-4 sm:mt-0">
                  <a href={translatePath(`/dashboard/events?edit=${evt.id}#event-form`)} class="text-xs text-[var(--color-tc-mustard)] hover:text-[var(--color-tc-mustard)]/80 font-bold underline">Modifier</a>
                  <a href={translatePath(`/events/${evt.id}`)} target="_blank" class="text-xs text-[var(--color-tc-blue)]/60 hover:text-[var(--color-tc-blue)] underline">Voir →</a>
                  <form method="POST" class="m-0 p-0 flex items-baseline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="eventId" value={evt.id} />
                    <button type="submit" onclick="return confirm('Supprimer cet événement définitivement ?')" class="text-xs text-red-500 hover:text-red-700 underline leading-none py-2 px-3 bg-red-50 rounded-lg border border-red-100 hover:bg-red-100 transition-colors">Supprimer</button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </main>
</Layout>
