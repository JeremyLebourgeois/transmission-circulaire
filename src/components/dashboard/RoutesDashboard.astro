---
import { getSupabaseServerClient } from '../../lib/supabase-server';

const supabase = getSupabaseServerClient(Astro.cookies);

let errorMessage = '';
let successMessage = '';

// Handle actions
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  try {
    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const { error } = await supabase.from('routes').delete().eq('id', id);
        if (error) throw error;
        successMessage = 'Route supprimée avec succès.';
      }
    } else if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString() || '';
      const description = formData.get('description')?.toString() || '';
      const imageFile = formData.get('image') as File;
      
      let imageUrl = formData.get('existing_image_url')?.toString() || '';

      if (imageFile && imageFile.size > 0) {
        const fileExt = imageFile.name.split('.').pop();
        const fileName = `${Date.now()}-route.${fileExt}`;
        const { error: uploadError } = await supabase.storage
          .from('routes_images')
          .upload(fileName, imageFile, { upsert: true });
        
        if (uploadError) {
          // Si le bucket n'existe pas, on l'indique. L'utilisateur devra le créer dans Supabase.
          if (uploadError.message.includes('Bucket not found')) {
            throw new Error("Le bucket 'routes_images' n'existe pas dans Supabase Storage. Veuillez le créer et le rendre public.");
          }
          throw uploadError;
        }
        
        const { data: { publicUrl } } = supabase.storage.from('routes_images').getPublicUrl(fileName);
        imageUrl = publicUrl;
      }

      if (action === 'create') {
        const { error } = await supabase.from('routes').insert({ title, description, image_url: imageUrl });
        if (error) throw error;
        successMessage = 'Route créée avec succès.';
      } else {
        const { error } = await supabase.from('routes').update({ title, description, image_url: imageUrl }).eq('id', id);
        if (error) throw error;
        successMessage = 'Route mise à jour avec succès.';
      }
    }
  } catch (e: any) {
    errorMessage = e.message;
  }
}

// Fetch existing routes
const { data: routes, error: fetchError } = await supabase
  .from('routes')
  .select('*')
  .order('created_at', { ascending: false });

let dbMissing = false;
if (fetchError && fetchError.code === '42P01') {
  dbMissing = true;
}

// Check if we are editing a specific route
const editId = Astro.url.searchParams.get('edit');
const routeToEdit = editId && routes ? routes.find(r => r.id === editId) : null;
---

<div>
  {errorMessage && (
    <div class="mb-8 p-4 bg-red-100 border border-red-300 text-red-800 rounded-xl font-medium">
      {errorMessage}
    </div>
  )}

  {successMessage && (
    <div class="mb-8 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl font-medium">
      {successMessage}
    </div>
  )}

  {dbMissing ? (
    <div class="p-8 bg-red-50 rounded-2xl border-2 border-red-200 text-center">
      <p class="text-red-600 font-bold mb-2">Les tables SQL ne sont pas encore créées.</p>
      <p class="text-sm text-red-500">Veuillez exécuter le script SQL dans Supabase pour créer la table 'routes'.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Formulaire Création / Edition -->
      <div class="lg:col-span-1">
        <div class="bg-[var(--color-tc-card)] rounded-3xl shadow-lg border border-[var(--color-tc-blue)]/10 p-6 sticky top-6">
          <h2 class="text-xl font-bold text-[var(--color-tc-blue)] mb-6">
            {routeToEdit ? "Modifier la route" : "Nouvelle route"}
          </h2>

          <form method="POST" enctype="multipart/form-data" class="space-y-5">
            <input type="hidden" name="action" value={routeToEdit ? "update" : "create"} />
            {routeToEdit && <input type="hidden" name="id" value={routeToEdit.id} />}
            {routeToEdit && <input type="hidden" name="existing_image_url" value={routeToEdit.image_url || ''} />}

            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Nom de la route *</label>
              <input type="text" name="title" required value={routeToEdit?.title || ''} placeholder="Nom de la route ..." class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-[var(--color-tc-blue)]" />
            </div>

            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Description</label>
              <textarea name="description" rows="4" placeholder="Description de la route ..." class="w-full rounded-xl border-0 py-3 px-4 bg-[var(--color-tc-cream)] ring-1 ring-[var(--color-tc-blue)]/20 focus:ring-2 focus:ring-[var(--color-tc-red)] text-[var(--color-tc-blue)]">{routeToEdit?.description || ''}</textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-[var(--color-tc-blue)] mb-2">Image d'illustration globale</label>
              <input type="file" name="image" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[var(--color-tc-red)]/10 file:text-[var(--color-tc-red)] hover:file:bg-[var(--color-tc-red)]/20" />
              {routeToEdit?.image_url && (
                <div class="mt-3">
                  <p class="text-xs text-gray-500 mb-1">Image actuelle :</p>
                  <img src={routeToEdit.image_url} alt="Aperçu" class="w-full h-32 object-cover rounded-lg border border-gray-200" />
                </div>
              )}
            </div>

            <div class="pt-4 flex flex-col gap-3">
              <button type="submit" class="w-full rounded-full bg-[var(--color-tc-red)] px-6 py-3 text-sm font-bold text-white shadow-sm hover:bg-opacity-90 transition-all transform hover:-translate-y-0.5">
                {routeToEdit ? "Enregistrer les modifications" : "Créer la route"}
              </button>
              {routeToEdit && (
                <a href="/dashboard/routes" class="w-full text-center text-sm font-bold text-[var(--color-tc-blue)] hover:underline">
                  Annuler l'édition
                </a>
              )}
            </div>
          </form>
        </div>
      </div>

      <!-- Liste des routes -->
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-xl font-bold text-[var(--color-tc-blue)]">Vos Routes ({routes?.length || 0})</h2>
        
        {routes?.length === 0 ? (
          <div class="bg-[var(--color-tc-cream)] border-2 border-dashed border-[var(--color-tc-blue)]/20 rounded-3xl p-12 text-center">
            <p class="text-[var(--color-tc-blue)]/60 font-medium">Aucune route n'a été créée pour le moment.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {routes?.map((route) => (
              <div class="bg-white rounded-2xl shadow-sm border border-[var(--color-tc-blue)]/10 overflow-hidden flex flex-col">
                {route.image_url ? (
                  <img src={route.image_url} alt={route.title} class="w-full h-32 object-cover" />
                ) : (
                  <div class="w-full h-32 bg-gray-100 flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                
                <div class="p-5 flex-1 flex flex-col">
                  <h3 class="font-bold text-[var(--color-tc-blue)] mb-2 line-clamp-1">{route.title}</h3>
                  <p class="text-sm text-[var(--color-tc-blue)]/70 line-clamp-2 mb-4 flex-1">
                    {route.description || "Aucune description"}
                  </p>
                  
                  <div class="flex flex-wrap items-center gap-2 mt-auto pt-4 border-t border-[var(--color-tc-blue)]/10">
                    <a href={`/dashboard/routes?edit=${route.id}`} class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold py-2 px-3 rounded-xl transition-colors">
                      Modifier
                    </a>
                    
                    {/* Bouton pour gérer les points (À faire plus tard) */}
                    <a href={`/dashboard/routes/${route.id}/points`} class="flex-[2] text-center bg-[var(--color-tc-olive)] hover:bg-opacity-90 text-white text-xs font-bold py-2 px-3 rounded-xl transition-colors flex items-center justify-center gap-1">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                      </svg>
                      Gérer la carte
                    </a>

                    <form method="POST" class="inline" onsubmit="return confirm('Attention ! Supprimer cette route supprimera aussi TOUS ses points et connexions. Continuer ?');">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={route.id} />
                      <button type="submit" class="flex-shrink-0 text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors" title="Supprimer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )}
</div>
