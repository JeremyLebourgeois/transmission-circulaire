<!-- Données JSON des messages pour rotation aléatoire côté client -->
<script type="application/json" id="guestbook-messages-data" set:html={JSON.stringify(displayMessages)}></script>

<script is:inline>
  (function() {
    const dataEl = document.getElementById('guestbook-messages-data');
    if (!dataEl) return;

    let messages = [];
    try {
      messages = JSON.parse(dataEl.textContent || '[]');
    } catch(e) {
      console.error('Error parsing guestbook messages:', e);
    }

    if (!messages || messages.length === 0) return;

    const textEl = document.getElementById('guestbook-message-text');
    const avatarEl = document.getElementById('guestbook-author-avatar');
    const nameEl = document.getElementById('guestbook-author-name');
    const dateEl = document.getElementById('guestbook-message-date');
    const cardEl = document.getElementById('pinned-guestbook-card');

    if (!textEl || !avatarEl || !nameEl || !dateEl || !cardEl) return;

    let currentIndex = 0;
    let isPaused = false;
    let timer = null;

    cardEl.addEventListener('mouseenter', () => { isPaused = true; });
    cardEl.addEventListener('mouseleave', () => { isPaused = false; });

    function pickRandomIndex() {
      if (messages.length <= 1) return 0;
      let nextIndex;
      do {
        nextIndex = Math.floor(Math.random() * messages.length);
      } while (nextIndex === currentIndex);
      return nextIndex;
    }

    function switchMessage() {
      if (isPaused) return;

      cardEl.classList.add('opacity-0', 'scale-95', 'pointer-events-none');

      setTimeout(() => {
        currentIndex = pickRandomIndex();
        const msg = messages[currentIndex];

        textEl.textContent = '« ' + msg.message + ' »';
        nameEl.textContent = msg.author;
        dateEl.textContent = msg.date;
        avatarEl.textContent = (msg.author || 'A').charAt(0).toUpperCase();

        setTimeout(() => {
          if (!isPaused) {
            cardEl.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          }
        }, 900);
      }, 700);
    }

    function scheduleNext() {
      const delay = Math.floor(Math.random() * 2000) + 5500;
      timer = setTimeout(() => {
        switchMessage();
        scheduleNext();
      }, delay);
    }

    scheduleNext();
  })();
</script>
