---
export const prerender = false;

import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const supabase = getSupabaseServerClient(Astro.cookies);

const { data: books } = await supabase
  .from('books')
  .select('id, title, short_description, main_image_url')
  .order('created_at', { ascending: false })
  .limit(3);

const { data: events } = await supabase
  .from('events')
  .select('id, title, date, end_date, location')
  .order('date', { ascending: true })
  .limit(3);
---

<!-- ─────────────────────────────────────────────
  1. LES 3 PILIERS
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">

      <!-- Pilier 1 : Notre Vision -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-blue)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">Notre Vision</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">Relier les générations et les cultures.</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">Nous croyons que chaque culture porte en elle des savoirs précieux qui méritent d'être transmis, partagés et célébrés.</p>
      </div>

      <!-- Pilier 2 : Notre Engagement -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-olive)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">Notre Engagement</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">Faire vivre ce qui nous relie.</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">Par nos projets éditoriaux, artistiques et humains, nous construisons des connexions durables entre les individus, les territoires et les époques.</p>
      </div>

      <!-- Pilier 3 : Nos Routes -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-red)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">Nos Routes Circulaires</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">Transmettre pour créer ensemble.</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">Des routes de rencontres entre créateurs du monde entier, tissant des liens inédits autour des savoir-faire, des patrimoines et des cultures.</p>
      </div>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  2. NOTRE RAISON D'ÊTRE
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream)] py-12 sm:py-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      
      <!-- Image à gauche -->
      <div class="relative w-full max-w-lg mx-auto lg:max-w-none rounded-3xl overflow-hidden shadow-xl border border-[var(--color-tc-blue)]/10">
        <img src="/partage.png" alt="Transmission et partage" class="w-full h-auto object-cover" />
      </div>

      <!-- Texte à droite -->
      <div class="text-center lg:text-left">
        <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
          Faire de la transmission une force pour demain.
        </h2>
        <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/70">
          Transmission Circulaire crée des passerelles entre générations, cultures, territoires et savoir-faire. Nous croyons que transmettre, c'est aussi partager, faire évoluer et créer ensemble.
        </p>
        <div class="mt-8 flex justify-center lg:justify-start">
          <a
            href={translatePath('/about')}
            class="rounded-full bg-[var(--color-tc-blue)] px-8 py-3 text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
          >
            Découvrir l'association →
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  3. LES ROUTES CIRCULAIRES
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      
      <!-- Texte à gauche (sur desktop) -->
      <div class="text-center lg:text-left">
        <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
          Les Routes Circulaires
        </h2>
        <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/70">
          Les Routes Circulaires sont des parcours de rencontres où des créateurs, artisans et intellectuels de différents pays se retrouvent autour de savoir-faire, de cultures et de patrimoines pour imaginer et créer ensemble. Un programme unique qui fait circuler les idées, les gestes et les humanités.
        </p>
        <div class="mt-8 flex justify-center lg:justify-start">
          <button
            disabled
            title="Bientôt disponible"
            class="rounded-full bg-[var(--color-tc-olive)] px-8 py-3 text-sm font-semibold text-white shadow-md opacity-50 cursor-not-allowed"
          >
            Découvrir nos routes →
          </button>
        </div>
      </div>

      <!-- Image à droite (en haut sur mobile) -->
      <div class="relative w-full max-w-lg mx-auto lg:max-w-none rounded-3xl overflow-hidden shadow-xl border border-[var(--color-tc-blue)]/10 order-first lg:order-last">
        <img src="/carte.png" alt="Les Routes Circulaires" class="w-full h-auto object-cover" />
      </div>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  4. NOS LIVRES
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-8 gap-4">
      <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
        Nos Livres
      </h2>
      <a
        href={translatePath('/books')}
        class="text-sm font-semibold text-[var(--color-tc-mustard)] hover:underline flex items-center gap-1 group whitespace-nowrap"
      >
        Découvrir nos livres
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    {books && books.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {books.map(book => (
          <a href={translatePath(`/books/${book.id}`)} class="group flex flex-col gap-4 rounded-3xl overflow-hidden bg-[var(--color-tc-cream-dark)] border border-[var(--color-tc-blue)]/5 shadow-sm hover:shadow-md transition-shadow">
            {book.main_image_url ? (
              <img src={book.main_image_url} alt={book.title} class="w-full h-52 object-cover" />
            ) : (
              <div class="w-full h-52 bg-[var(--color-tc-blue)]/10 flex items-center justify-center">
                <svg class="w-10 h-10 text-[var(--color-tc-blue)]/30" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
              </div>
            )}
            <div class="p-5 flex flex-col gap-2">
              <h3 class="font-bold text-[var(--color-tc-blue)] group-hover:text-[var(--color-tc-mustard)] transition-colors">{book.title}</h3>
              {book.short_description && (
                <p class="text-sm text-[var(--color-tc-blue)]/60 line-clamp-2">{book.short_description}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-[var(--color-tc-blue)]/50 italic text-sm">Aucun livre disponible pour l'instant.</p>
    )}
  </div>
</section>

<!-- ─────────────────────────────────────────────
  5. ÉVÉNEMENTS
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-8 gap-4">
      <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
        Événements
      </h2>
      <a
        href={translatePath('/events')}
        class="text-sm font-semibold text-[var(--color-tc-mustard)] hover:underline flex items-center gap-1 group whitespace-nowrap"
      >
        Voir les événements
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    {events && events.length > 0 ? (
      <div class="flex flex-col gap-4">
        {events.map(event => (
          <div class="flex items-center gap-6 p-5 rounded-2xl bg-[var(--color-tc-cream)] border border-[var(--color-tc-blue)]/5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex-shrink-0 h-12 w-12 flex items-center justify-center rounded-xl bg-[var(--color-tc-red)]/10">
              <svg class="h-6 w-6 text-[var(--color-tc-red)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-[var(--color-tc-blue)] truncate">{event.title}</p>
              <p class="text-xs text-[var(--color-tc-blue)]/50 mt-0.5">
                {event.end_date ? (
                  <>Du {new Date(event.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} au {new Date(event.end_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</>
                ) : (
                  event.date ? new Date(event.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : ''
                )}
                {event.location ? ` · ${event.location}` : ''}
              </p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-[var(--color-tc-blue)]/50 italic text-sm">Aucun événement à venir pour l'instant. Revenez bientôt !</p>
    )}
  </div>
</section>

<!-- ─────────────────────────────────────────────
  6. CTA FINAL
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-blue)] py-12 sm:py-20">
  <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-display font-bold tracking-tight text-white sm:text-4xl">
      Vous avez quelque chose à transmettre ?
    </h2>
    <p class="mt-4 text-lg leading-8 text-white/70">
      Rejoignez une communauté qui fait circuler les savoirs, les cultures et les générations.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={translatePath('/register')}
        class="rounded-full bg-[var(--color-tc-mustard)] px-8 py-3 text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
      >
        Rejoindre le mouvement
      </a>
      <a
        href={translatePath('/donate')}
        class="rounded-full border border-white/40 px-8 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-all"
      >
        Soutenir l'association
      </a>
    </div>
  </div>
</section>
