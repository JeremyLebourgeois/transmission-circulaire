---
export const prerender = false;

import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { getSupabaseServerClient } from '../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const supabase = getSupabaseServerClient(Astro.cookies);

const { data: books } = await supabase
  .from('books')
  .select('id, title, title_en, short_description, short_description_en, main_image_url')
  .order('created_at', { ascending: false })
  .limit(3);

const { data: events } = await supabase
  .from('events')
  .select('id, title, title_en, date, end_date, location, image_url')
  .order('date', { ascending: false })
  .limit(3);

const { data: guestbookData } = await supabase
  .from('guestbook')
  .select('id, message, created_at, is_featured, profiles(full_name)')
  .order('created_at', { ascending: false });

const guestbookMessages = guestbookData || [];

const fallbackMessages = lang === 'en' ? [
  {
    id: 'f1',
    message: "An inspiring initiative that gives true meaning to sharing skills and connecting generations.",
    author: "A passionate member",
    date: "Guestbook"
  },
  {
    id: 'f2',
    message: "Looking forward to following the next steps of the Circular Routes and discovering the wealth of living heritage!",
    author: "A curious traveler",
    date: "Guestbook"
  },
  {
    id: 'f3',
    message: "To transmit is not only to remember, it is to create a more united and creative future together.",
    author: "A partner artisan",
    date: "Guestbook"
  }
] : [
  {
    id: 'f1',
    message: "Une initiative inspirante qui donne tout son sens au partage des savoir-faire et à la rencontre entre générations.",
    author: "Un membre passionné",
    date: "Livre d'or"
  },
  {
    id: 'f2',
    message: "Hâte de suivre les prochaines étapes des Routes Circulaires et de découvrir la richesse des patrimoines vivants !",
    author: "Une voyageuse curieuse",
    date: "Livre d'or"
  },
  {
    id: 'f3',
    message: "Transmettre n'est pas seulement se souvenir, c'est créer ensemble un avenir plus solidaire et créatif.",
    author: "Un artisan partenaire",
    date: "Livre d'or"
  }
];

const displayMessages = guestbookMessages.length > 0
  ? guestbookMessages.map(m => ({
      id: m.id,
      message: m.message,
      author: m.profiles?.full_name || (lang === 'en' ? 'A visitor' : 'Un visiteur'),
      date: new Date(m.created_at).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }),
      is_featured: m.is_featured
    }))
  : fallbackMessages;

const firstMessage = displayMessages[Math.floor(Math.random() * displayMessages.length)];
---

<!-- ─────────────────────────────────────────────
  1. LES 3 PILIERS
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">

      <!-- Pilier 1 : Notre Vision -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-blue)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">{lang === 'en' ? 'Our Vision' : 'Notre Vision'}</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">{lang === 'en' ? 'Connecting generations and cultures.' : 'Relier les générations et les cultures.'}</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">
          {lang === 'en' 
            ? 'We believe that every culture holds precious knowledge worth passing on, sharing, and celebrating.'
            : 'Nous croyons que chaque culture porte en elle des savoirs précieux qui méritent d\'être transmis, partagés et célébrés.'}
        </p>
      </div>

      <!-- Pilier 2 : Notre Engagement -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-olive)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">{lang === 'en' ? 'Our Commitment' : 'Notre Engagement'}</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">{lang === 'en' ? 'Bringing alive what connects us.' : 'Faire vivre ce qui nous relie.'}</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">
          {lang === 'en'
            ? 'Through our editorial, artistic, and human initiatives, we build lasting connections between people, territories, and eras.'
            : 'Par nos projets éditoriaux, artistiques et humains, nous construisons des connexions durables entre les individus, les territoires et les époques.'}
        </p>
      </div>

      <!-- Pilier 3 : Nos Routes -->
      <div class="flex flex-col items-start gap-4">
        <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-[var(--color-tc-red)]">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-tc-blue)]">{lang === 'en' ? 'Our Circular Routes' : 'Nos Routes Circulaires'}</h3>
        <p class="text-base font-semibold text-[var(--color-tc-mustard)]">{lang === 'en' ? 'Transmitting to create together.' : 'Transmettre pour créer ensemble.'}</p>
        <p class="text-sm leading-6 text-[var(--color-tc-blue)]/70">
          {lang === 'en'
            ? 'Meeting journeys between creators from around the world, weaving new bonds around craftsmanship, heritage, and cultures.'
            : 'Des routes de rencontres entre créateurs du monde entier, tissant des liens inédits autour des savoir-faire, des patrimoines et des cultures.'}
        </p>
      </div>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  2. NOTRE RAISON D'ÊTRE
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream)] py-12 sm:py-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      
      <!-- Image à gauche -->
      <div class="relative w-full max-w-md mx-auto aspect-square rounded-3xl overflow-hidden shadow-xl border border-[var(--color-tc-blue)]/10 bg-white flex items-center justify-center">
        <img src="/logo-livre.png" alt="Transmission Circulaire" class="w-full h-full object-cover" />
      </div>

      <!-- Texte à droite -->
      <div class="text-center lg:text-left">
        <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
          {lang === 'en' ? 'Making transmission a force for tomorrow.' : 'Faire de la transmission une force pour demain.'}
        </h2>
        <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/70">
          {lang === 'en'
            ? 'Circular Transmission builds bridges between generations, cultures, regions, and crafts. We believe that transmitting also means sharing, evolving, and creating together.'
            : 'Transmission Circulaire crée des passerelles entre générations, cultures, territoires et savoir-faire. Nous croyons que transmettre, c\'est aussi partager, faire évoluer et créer ensemble.'}
        </p>
        <div class="mt-8 flex justify-center lg:justify-start">
          <a
            href={translatePath('/about')}
            class="rounded-full bg-[var(--color-tc-blue)] px-8 py-3 text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
          >
            {lang === 'en' ? 'Discover the association →' : 'Découvrir l\'association →'}
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  3. LES ROUTES CIRCULAIRES
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      
      <!-- Texte à gauche (sur desktop) -->
      <div class="text-center lg:text-left">
        <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
          {lang === 'en' ? 'The Circular Routes' : 'Les Routes Circulaires'}
        </h2>
        <p class="mt-4 text-lg leading-8 text-[var(--color-tc-blue)]/70">
          {lang === 'en'
            ? 'The Circular Routes are exploratory journeys where creators, artisans, and intellectuals from different countries come together around craftsmanship, culture, and heritage to imagine and create together. A unique initiative circulating ideas, gestures, and human connection.'
            : 'Les Routes Circulaires sont des parcours de rencontres où des créateurs, artisans et intellectuels de différents pays se retrouvent autour de savoir-faire, de cultures et de patrimoines pour imaginer et créer ensemble. Un programme unique qui fait circuler les idées, les gestes et les humanités.'}
        </p>
        <div class="mt-8 flex justify-center lg:justify-start">
          <a
            href={translatePath('/routes')}
            class="rounded-full bg-[var(--color-tc-olive)] px-8 py-3 text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
          >
            {lang === 'en' ? 'Discover our routes →' : 'Découvrir nos routes →'}
          </a>
        </div>
      </div>

      <!-- Image à droite (en haut sur mobile) -->
      <div class="relative w-full max-w-lg mx-auto lg:max-w-none rounded-3xl overflow-hidden shadow-xl border border-[var(--color-tc-blue)]/10 order-first lg:order-last">
        <img src="/carte.png" alt="Les Routes Circulaires" class="w-full h-auto object-cover" />
      </div>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────
  4. NOS LIVRES
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-8 gap-4">
      <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-blue)] sm:text-4xl">
        {lang === 'en' ? 'Our Books' : 'Nos Livres'}
      </h2>
      <a
        href={translatePath('/books')}
        class="text-sm font-semibold text-[var(--color-tc-blue)] hover:underline flex items-center gap-1 group whitespace-nowrap"
      >
        {lang === 'en' ? 'Discover our books' : 'Découvrir nos livres'}
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    {books && books.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {books.map(book => {
          const displayTitle = (lang === 'en' && book.title_en) ? book.title_en : book.title;
          const displayDesc = (lang === 'en' && book.short_description_en) ? book.short_description_en : book.short_description;
          return (
            <a href={translatePath(`/books/${book.id}`)} class="group flex flex-col gap-4 rounded-3xl overflow-hidden bg-[var(--color-tc-cream-dark)] border-2 border-[var(--color-tc-blue)] shadow-sm hover:shadow-md transition-shadow">
              {book.main_image_url ? (
                <img src={book.main_image_url} alt={displayTitle} class="w-full h-52 object-cover" />
              ) : (
                <div class="w-full h-52 bg-[var(--color-tc-blue)]/10 flex items-center justify-center">
                  <svg class="w-10 h-10 text-[var(--color-tc-blue)]/30" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                </div>
              )}
              <div class="p-5 flex flex-col gap-2">
                <h3 class="font-bold text-[var(--color-tc-blue)] group-hover:text-[var(--color-tc-mustard)] transition-colors">{displayTitle}</h3>
                {displayDesc && (
                  <p class="text-sm text-[var(--color-tc-blue)]/60 line-clamp-2">{displayDesc}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-[var(--color-tc-blue)]/50 italic text-sm">{lang === 'en' ? 'No books available at the moment.' : 'Aucun livre disponible pour l\'instant.'}</p>
    )}
  </div>
</section>

<!-- ─────────────────────────────────────────────
  5. ÉVÉNEMENTS
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-cream-dark)] py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-8 gap-4">
      <h2 class="text-3xl font-display font-bold tracking-tight text-[var(--color-tc-olive)] sm:text-4xl">
        {lang === 'en' ? 'Events' : 'Événements'}
      </h2>
      <a
        href={translatePath('/events')}
        class="text-sm font-semibold text-[var(--color-tc-olive)] hover:underline flex items-center gap-1 group whitespace-nowrap"
      >
        {lang === 'en' ? 'View events' : 'Voir les événements'}
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    {events && events.length > 0 ? (
      <div class="flex flex-col gap-4">
        {events.map(event => {
          const displayTitle = (lang === 'en' && event.title_en) ? event.title_en : event.title;
          const eventDate = event.end_date ? new Date(event.end_date) : new Date(event.date);
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const isPast = eventDate < today;
          const Wrapper = isPast ? 'div' : 'a';
          const wrapperProps = isPast ? {} : { href: translatePath(`/events/${event.id}`) };
          
          return (
          <Wrapper {...wrapperProps} class={`flex items-center gap-6 p-5 rounded-2xl bg-[var(--color-tc-cream)] border-2 border-[var(--color-tc-olive)] shadow-sm transition-all group ${!isPast ? 'hover:shadow-md hover:-translate-y-0.5 hover:border-[var(--color-tc-mustard)]/70 cursor-pointer block w-full' : 'opacity-80'}`}>
            <div class={`flex-shrink-0 h-16 w-16 overflow-hidden flex items-center justify-center rounded-xl ${!isPast ? 'bg-[var(--color-tc-red)]/10' : 'bg-gray-200'}`}>
              {event.image_url ? (
                <img src={event.image_url} alt={displayTitle} class={`w-full h-full object-cover ${isPast ? 'grayscale opacity-70' : ''}`} />
              ) : (
                <svg class={`h-6 w-6 ${!isPast ? 'text-[var(--color-tc-red)]' : 'text-gray-500'}`} fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-[var(--color-tc-olive)] truncate">{displayTitle}</p>
              <div class="text-xs text-[var(--color-tc-blue)]/50 mt-1 flex flex-col gap-0.5">
                {event.end_date ? (
                  lang === 'en' ? (
                    <>
                      <span>From {new Date(event.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                      <span>To {new Date(event.end_date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                    </>
                  ) : (
                    <>
                      <span>Du {new Date(event.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                      <span>Au {new Date(event.end_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                    </>
                  )
                ) : (
                  <span>{event.date ? new Date(event.date).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : ''}</span>
                )}
                {event.location && <span class="mt-0.5 text-[var(--color-tc-blue)]/40 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {event.location}
                </span>}
              </div>
            </div>
            {!isPast && (
              <div class="text-[var(--color-tc-mustard)] opacity-0 group-hover:opacity-100 transition-opacity ml-auto pl-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </Wrapper>
          );
        })}
      </div>
    ) : (
      <p class="text-[var(--color-tc-blue)]/50 italic text-sm">{lang === 'en' ? 'No upcoming events at the moment. Check back soon!' : 'Aucun événement à venir pour l\'instant. Revenez bientôt !'}</p>
    )}
  </div>
</section>

<!-- ─────────────────────────────────────────────
  6. CTA FINAL
───────────────────────────────────────────── -->
<section class="bg-[var(--color-tc-blue)] py-12 sm:py-20 relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[36rem] h-[36rem] bg-[var(--color-tc-mustard)]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-3xl font-display font-bold tracking-tight text-white sm:text-4xl">
      {lang === 'en' ? 'Do you have something to pass on?' : 'Vous avez quelque chose à transmettre ?'}
    </h2>
    <p class="mt-4 text-lg leading-8 text-white/70">
      {lang === 'en'
        ? 'Join a community that brings knowledge, cultures, and generations into circulation.'
        : 'Rejoignez une communauté qui fait circuler les savoirs, les cultures et les générations.'}
    </p>

    <!-- Box Épinglée du Livre d'or -->
    <div class="my-8 max-w-xl mx-auto text-left min-h-[175px] sm:min-h-[155px] flex items-center justify-center">
      <div 
        id="pinned-guestbook-card" 
        class="w-full relative bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 sm:p-7 shadow-2xl transition-all duration-700 ease-in-out hover:bg-white/15 hover:border-[var(--color-tc-mustard)]/40 group transform"
      >
        <!-- En-tête de la box -->
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-tc-mustard)]/20 border border-[var(--color-tc-mustard)]/40 text-[var(--color-tc-mustard)] text-xs font-bold tracking-wide">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 12V4H17V2H7V4H8V12L6 14V16H11V22H13V16H18V14L16 12Z"/>
            </svg>
            {lang === 'en' ? 'Guestbook' : 'Livre d\'or'}
          </span>
          <a 
            href={translatePath('/donate') + "#guestbook"} 
            class="text-xs text-white/60 hover:text-[var(--color-tc-mustard)] transition-colors inline-flex items-center gap-1"
            title={lang === 'en' ? 'View guestbook' : 'Consulter le livre d\'or'}
          >
            {lang === 'en' ? 'View guestbook' : 'Voir le livre'} <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>

        <!-- Citation et auteur -->
        <div>
          <p id="guestbook-message-text" class="font-serif italic text-base sm:text-lg text-white/95 leading-relaxed mb-4">
            « {firstMessage.message} »
          </p>

          <div class="flex items-center gap-3">
            <div id="guestbook-author-avatar" class="w-8 h-8 rounded-full bg-[var(--color-tc-mustard)]/30 border border-[var(--color-tc-mustard)]/50 flex items-center justify-center text-xs font-bold text-[var(--color-tc-mustard)] flex-shrink-0">
              {firstMessage.author.charAt(0).toUpperCase()}
            </div>
            <div class="text-xs">
              <span id="guestbook-author-name" class="font-bold text-white block">
                {firstMessage.author}
              </span>
              <span id="guestbook-message-date" class="text-white/50 block">
                {firstMessage.date}
              </span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={translatePath('/register')}
